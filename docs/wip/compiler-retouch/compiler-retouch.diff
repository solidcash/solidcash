+#!/usr/bin/env node
+/* eslint-disable @typescript-eslint/explicit-function-return-type */
+/*
+ * Compile one marketplace contract with a tree's own compiler and print hashes over the published metadata that
+ * must match across trees: ABI, admission, state layout, verifier program, handler verdicts, events, fingerprint.
+ * Bodies and debug references are representation-bearing and are compared separately via
+ * `scripts/body-parity-marketplace.mjs`.
+ *
+ *   node scripts/metadata-parity-marketplace.mjs <tree> <kernel|framed> <contract>
+ *
+ * Run it against both trees and compare `metadataSha` and `stateLayoutSha`.
+ */
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { pathToFileURL } from 'node:url';
+
+const [tree, mode, contract] = process.argv.slice(2);
+if (!tree || !mode || !contract) throw new Error('usage: metadata-parity-marketplace.mjs <tree> <kernel|framed> <contract>');
+const { compileFileMulti } = await import(pathToFileURL(path.join(tree, 'packages/solidc/dist/index.js')).href);
+const source = path.join(tree, '.marketplace/contracts', `${contract}.sol`);
+const artifacts = compileFileMulti(source, {
+  evmCompat: true,
+  messageBus: true,
+  messageBusKernel: mode === 'kernel',
+  ...(mode === 'framed' ? { composition: 'framed' } : {}),
+  messageBusGraphContext: true,
+  ecrecover: 'p2pkh',
+  optimizeForCompilationSpeed: true,
+  suppressWarnings: true,
+  maximumInputBytes: 10_000_000,
+  commitmentLimit: 10_000_000,
+  __artifactCache: false,
+  __attemptFailureBox: { failures: [] },
+  __strictNoInternalRecovery: true,
+});
+const artifact = artifacts[contract];
+if (artifact === undefined) throw new Error(`no artifact for ${contract}`);
+const sha = (value) => createHash('sha256').update(JSON.stringify(value ?? null)).digest('hex');
+const handlers = artifact.messageBus?.handlers ?? [];
+const projection = {
+  contractName: artifact.contractName,
+  constructorInputs: artifact.constructorInputs,
+  stateLayout: artifact.stateLayout,
+  events: artifact.events,
+  fingerprint: artifact.fingerprint,
+  compiler: artifact.compiler,
+  source: artifact.source,
+  abi: artifact.abi,
+  invocationAnalysis: artifact.invocationAnalysis,
+  messageBus: artifact.messageBus,
+  handlers: handlers.map((handler) => ({
+    name: handler.name,
+    selector: handler.selector,
+    eligible: handler.eligible,
+    rejectionCode: handler.rejectionCode,
+    rejectionReason: handler.rejectionReason,
+  })),
+};
+console.log(JSON.stringify({
+  tree,
+  mode,
+  contract,
+  metadataSha: sha(projection),
+  stateLayoutSha: sha(artifact.stateLayout),
+  stateLayout: artifact.stateLayout,
+  fingerprint: artifact.fingerprint,
+  bytecodeSha: sha(artifact.bytecode),
+  jsonBytes: Buffer.byteLength(JSON.stringify(artifact)),
+}));
