+/**
+ * Shared scan for tagged `<tag><digest> OP_DROP` commitments in artifact ASM.
+ *
+ * The compiler stamps one commitment per eligible handler and verifies uniqueness of the whole script each time.
+ * The previous implementation did `trim().split(/\s+/)` and ran `^[0-9a-f]+$` on every token. This instead finds
+ * the 66-character data token with `indexOf` (C-speed), checks its token boundaries, and resolves the encoded
+ * `25<data>75` push the same way. Nothing is allocated, and one miss cannot scan to the end of the script per
+ * token the way a per-token search would.
+ *
+ * Token semantics match the original exactly:
+ * - tokens are ECMAScript whitespace-delimited (`\s`, including the Unicode space forms);
+ * - a spaced `<data> OP_DROP` pair counts once;
+ * - the minimally encoded `25<data>75` push counts once for every occurrence inside an all-lowercase-hex token.
+ */
+export function countTaggedCommitmentMatches(bytecode: string, data: string, drop: string): number {
+  const length = bytecode.length;
+  let matches = 0;
+
+  let at = bytecode.indexOf(data);
+  while (at >= 0) {
+    const afterData = at + data.length;
+    if ((at === 0 || isEcmaWhitespace(bytecode.charCodeAt(at - 1)))
+      && (afterData === length || isEcmaWhitespace(bytecode.charCodeAt(afterData)))) {
+      let next = afterData;
+      while (next < length && isEcmaWhitespace(bytecode.charCodeAt(next))) next += 1;
+      if (next > afterData && next < length && bytecode.startsWith(drop, next)) {
+        const afterDrop = next + drop.length;
+        if (afterDrop === length || isEcmaWhitespace(bytecode.charCodeAt(afterDrop))) matches += 1;
+      }
+    }
+    at = bytecode.indexOf(data, at + 1);
+  }
+
+  const encoded = `25${data}75`;
+  let tokenStart = -1;
+  let tokenEnd = -1;
+  at = bytecode.indexOf(encoded);
+  while (at >= 0) {
+    if (at < tokenStart || at + encoded.length > tokenEnd) {
+      tokenStart = at;
+      while (tokenStart > 0 && !isEcmaWhitespace(bytecode.charCodeAt(tokenStart - 1))) tokenStart -= 1;
+      tokenEnd = at + encoded.length;
+      while (tokenEnd < length && !isEcmaWhitespace(bytecode.charCodeAt(tokenEnd))) tokenEnd += 1;
+    }
+    if (isLowercaseHexToken(bytecode, tokenStart, tokenEnd)) matches += 1;
+    at = bytecode.indexOf(encoded, at + 1);
+  }
+  return matches;
+}
+
+function isLowercaseHexToken(value: string, start: number, end: number): boolean {
+  for (let index = start; index < end; index += 1) {
+    const code = value.charCodeAt(index);
+    if (!((code >= 0x30 && code <= 0x39) || (code >= 0x61 && code <= 0x66))) return false;
+  }
+  return true;
+}
+
+/** ECMAScript `\s` (WhiteSpace + LineTerminator); ASM is ASCII, but the API accepts arbitrary strings. */
+function isEcmaWhitespace(code: number): boolean {
+  return (code >= 0x09 && code <= 0x0d)
+    || code === 0x20
+    || code === 0xa0
+    || code === 0x1680
+    || (code >= 0x2000 && code <= 0x200a)
+    || code === 0x2028
+    || code === 0x2029
+    || code === 0x202f
+    || code === 0x205f
+    || code === 0x3000
+    || code === 0xfeff;
+}
