+    expect(countTaggedCommitmentMatches(`${marker} ${marker}`, data, drop)).toBe(2);
+    expect(countTaggedCommitmentMatches(`OP_1 ${marker} OP_2 ${marker}`, data, drop)).toBe(2);
+  });
+
+  it('uses ECMAScript whitespace between the data and drop tokens', () => {
+    expect(countTaggedCommitmentMatches(`\n\t${data}\r\n OP_DROP  `, data, drop)).toBe(1);
+    expect(countTaggedCommitmentMatches(`${data}\u00a0${drop}`, data, drop)).toBe(1);
+  });
+
+  it('requires both tokens to be whole tokens', () => {
+    expect(countTaggedCommitmentMatches(`${data}00 ${drop}`, data, drop)).toBe(0);
+    expect(countTaggedCommitmentMatches(`00${data} ${drop}`, data, drop)).toBe(0);
+    expect(countTaggedCommitmentMatches(`${data} OP_DROP00`, data, drop)).toBe(0);
+    expect(countTaggedCommitmentMatches(`${data} OP_1 ${drop}`, data, drop)).toBe(0);
+  });
+
+  it('counts the minimally encoded push inside an all-lowercase-hex token', () => {
+    expect(countTaggedCommitmentMatches(`OP_1 ${encoded} OP_2`, data, drop)).toBe(1);
+    expect(countTaggedCommitmentMatches(`aa${encoded}bb`, data, drop)).toBe(1);
+    expect(countTaggedCommitmentMatches(`${encoded}${encoded}`, data, drop)).toBe(2);
+  });
+
+  it('ignores the encoded push outside an all-hex token', () => {
+    expect(countTaggedCommitmentMatches(`zz${encoded}`, data, drop)).toBe(0);
+    expect(countTaggedCommitmentMatches(`${encoded.toUpperCase()}`, data, drop)).toBe(0);
+  });
+
+  it('feeds the public uniqueness check', () => {
+    expect(hasUniqueKernelPlanDigestCommitment(marker, digest)).toBe(true);
+    expect(hasUniqueKernelPlanDigestCommitment(`OP_1 ${encoded}`, digest)).toBe(true);
+    expect(hasUniqueKernelPlanDigestCommitment(`${marker} ${marker}`, digest)).toBe(false);
+    expect(hasUniqueKernelPlanDigestCommitment('OP_1', digest)).toBe(false);
+    expect(hasUniqueKernelPlanDigestCommitment(marker, 'not-hex')).toBe(false);
+  });
+});
