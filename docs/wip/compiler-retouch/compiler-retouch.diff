+#!/usr/bin/env node
+/* eslint-disable @typescript-eslint/explicit-function-return-type */
+/**
+ * Resolve every published body of one marketplace contract through the shipped artifact path and print sha256
+ * hashes for cross-tree comparison.
+ *
+ *   node scripts/body-parity-marketplace.mjs <compile-tree> <kernel|framed> <contract> <resolver-tree>
+ *
+ * `resolver-tree` supplies `resolveArtifactBody` from `@solidcash/utils`; the retouch tree is the one that ships
+ * compact body references, and raw references from an older artifact pass through the same function unchanged.
+ * Run it against both trees and compare the `bodies`/`invokes` maps (counts and hashes) and `jsonBytes`.
+ */
+import { createHash } from 'node:crypto';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const [tree, mode, contractName, resolverTree] = process.argv.slice(2);
+if (!tree || !mode || !contractName || !resolverTree) {
+  throw new Error(
+    'usage: body-parity-marketplace.mjs <compile-tree> <kernel|framed> <contract> <resolver-tree>',
+  );
+}
+if (mode !== 'kernel' && mode !== 'framed') throw new Error(`unknown mode: ${mode}`);
+
+const { compileFileMulti } = await import(pathToFileURL(path.join(tree, 'packages/solidc/dist/index.js')).href);
+const { resolveArtifactBody } = await import(
+  pathToFileURL(path.join(resolverTree, 'packages/utils/dist/index.js')).href
+);
+const source = path.join(tree, '.marketplace/contracts', `${contractName}.sol`);
+const artifacts = compileFileMulti(source, {
+  evmCompat: true,
+  messageBus: true,
+  messageBusKernel: mode === 'kernel',
+  ...(mode === 'framed' ? { composition: 'framed' } : {}),
+  messageBusGraphContext: true,
+  ecrecover: 'p2pkh',
+  optimizeForCompilationSpeed: true,
+  suppressWarnings: true,
+  maximumInputBytes: 10_000_000,
+  commitmentLimit: 10_000_000,
+  __artifactCache: false,
+  __attemptFailureBox: { failures: [] },
+  __strictNoInternalRecovery: true,
+});
+const artifact = artifacts[contractName];
+if (artifact === undefined) throw new Error(`no artifact for ${contractName}`);
+const sha = (value) => createHash('sha256').update(value ?? '').digest('hex');
+const resolve = (body) => resolveArtifactBody(artifact, body);
+const bodies = Object.fromEntries(
+  Object.entries(artifact.functionBodies ?? {}).map(([selector, body]) => [selector, sha(resolve(body))]),
+);
+const invokes = Object.fromEntries(
+  Object.entries(artifact.debug?.invokeDebug ?? {}).map(([id, info]) => [id, sha(resolve(info.bytecode))]),
+);
+console.log(JSON.stringify({
+  tree,
+  mode,
+  contract: contractName,
+  jsonBytes: Buffer.byteLength(JSON.stringify(artifact)),
+  bodyCount: Object.keys(bodies).length,
+  invokeCount: Object.keys(invokes).length,
+  bodies,
+  invokes,
+}));
