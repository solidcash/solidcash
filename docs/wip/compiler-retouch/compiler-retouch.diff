new file mode 100644
index 000000000..f4d053697
--- /dev/null
+++ b/packages/solidc/test/CompilerRetouch.test.ts
@@ -0,0 +1,172 @@
+import { describe, expect, it } from 'vitest';
+import { resolveArtifactBody } from '@solidcash/utils';
+import { clearCompileCache, compileString, getCompilerCacheSizes } from '../src/compiler.js';
+
+/**
+ * Compiler retouch: published body references, bounded in-process caches, and the framed admission probe. Each
+ * case drives the shipped entry point; the artifact/bytecode assertions are the observable the SDK consumes.
+ */
+
+const MULTI_ENTRY = `pragma solidcash ^0.14.0;
+contract Box {
+  int public stored;
+  function put(int next) { this.stored = next; require(true); }
+  function readValue() external returns (int) { return this.stored; }
+}`;
+
+describe('compiler retouch', () => {
+  it('publishes every function and invoke body as a resolvable reference', () => {
+    const artifact = compileString(MULTI_ENTRY, { messageBus: false });
+    const entries = Object.entries(artifact.functionBodies ?? {});
+    expect(entries.length).toBeGreaterThan(0);
+    let spans = 0;
+    for (const [, body] of entries) {
+      if (typeof body === 'object') spans += 1;
+      const hex = resolveArtifactBody(artifact, body);
+      expect(hex).toBeDefined();
+      expect(artifact.debug!.bytecode).toContain(hex!);
+      if (typeof body === 'object') expect(hex!.length).toBe(body.length * 2);
+    }
+    // The compaction must engage: a body the script carries verbatim is published as a byte range.
+    expect(spans).toBeGreaterThan(0);
+    for (const information of Object.values(artifact.debug!.invokeDebug ?? {})) {
+      const hex = resolveArtifactBody(artifact, information.bytecode);
+      expect(hex).toBeDefined();
+      expect(artifact.debug!.bytecode).toContain(hex!);
+    }
+    // Legacy raw references (disk-cache entries, fixtures) resolve unchanged.
+    expect(resolveArtifactBody({ debug: { bytecode: 'aabb' } }, 'aabb')).toBe('aabb');
+    expect(resolveArtifactBody({ debug: { bytecode: 'aabb' } }, { offset: 1, length: 1 })).toBe('bb');
+    expect(resolveArtifactBody({ debug: { bytecode: 'aabb' } }, undefined)).toBeUndefined();
+  });
+
+  it('bounds every in-process cache and clears them together', () => {
+    clearCompileCache();
+    for (let index = 0; index < 140; index += 1) {
+      compileString(
+        `pragma solidcash ^0.14.0; contract C${index} { function f() { require(true); } }`,
+        { messageBus: false, suppressWarnings: true, __artifactCache: true } as never,
+      );
+    }
+    // More distinct imported files than the imported-parse bound, so the cache fills and evicts.
+    const files: Record<string, string> = {};
+    const imports: string[] = [];
+    for (let index = 0; index < 30; index += 1) {
+      files[`lib${index}.scash`] = `pragma solidcash ^0.14.0; int constant LIB${index} = ${index};`;
+      imports.push(`import "./lib${index}.scash";`);
+    }
+    compileString(
+      `pragma solidcash ^0.14.0;\n${imports.join('\n')}\ncontract Importer { function f() { require(true); } }`,
+      { files, messageBus: false, suppressWarnings: true } as never,
+    );
+    // Multi-entry direct contracts compile every body once and produce no usage plan. A single-function
+    // legacy contract still takes the non-materialising probe, which keeps the plan cache on its bound and
+    // reset path; 17 distinct ones exceed the 16-entry bound.
+    const kernelOptions = {
+      messageBus: true, messageBusKernel: true, optimizeForCompilationSpeed: true, suppressWarnings: true,
+    } as never;
+    compileString(
+      `pragma solidcash ^0.14.0;
+contract BodyOnce {
+  int public stored;
+  function put(int next) { this.stored = next; require(true); }
+  function readValue() external returns (int) { return this.stored; }
+}`,
+      kernelOptions,
+    );
+    expect(getCompilerCacheSizes().probePlans).toBe(0);
+    const legacyOptions = {
+      messageBus: false, optimizeForCompilationSpeed: true, suppressWarnings: true,
+    } as never;
+    for (let index = 0; index < 17; index += 1) {
+      compileString(
+        `pragma solidcash ^0.14.0;
+contract Plan${index} {
+  int public stored;
+  function put(int next) { this.stored = next; require(true); }
+}`,
+        legacyOptions,
+      );
+    }
+    const sizes = getCompilerCacheSizes();
+    // Record the observed counts against the live limits: the scratch log is the handoff evidence.
+    console.log(
+      `[cache-bound] distinctImports=30 importedParses=${sizes.importedParses}/${sizes.limits.importedParses} `
+      + `legacyPlans=${sizes.probePlans}/${sizes.limits.probePlans}`,
+    );
+    expect(sizes.artifacts).toBeGreaterThan(0);
+    expect(sizes.artifacts).toBeLessThanOrEqual(sizes.limits.artifacts);
+    expect(sizes.multiArtifacts).toBeLessThanOrEqual(sizes.limits.multiArtifacts);
+    // 30 distinct imports exceed the parse bound; 17 legacy single-function contracts exceed the plan bound.
+    expect(sizes.importedParses).toBe(Math.min(30, sizes.limits.importedParses));
+    expect(sizes.probePlans).toBe(Math.min(17, sizes.limits.probePlans));
+    expect(sizes.importedParses).toBeLessThanOrEqual(sizes.limits.importedParses);
+    expect(sizes.probePlans).toBeLessThanOrEqual(sizes.limits.probePlans);
+    clearCompileCache();
+    const cleared = getCompilerCacheSizes();
+    console.log(
+      `[cache-bound] afterClear importedParses=${cleared.importedParses} probePlans=${cleared.probePlans}`,
+    );
+    expect(cleared).toMatchObject({
+      artifacts: 0, multiArtifacts: 0, importedParses: 0, probePlans: 0,
+    });
+  });
+
+  it('compiles a multi-entry contract twice without a separate usage pass', () => {
+    clearCompileCache();
+    const source = `pragma solidcash ^0.14.0;
+contract BusProbe {
+  int public stored;
+  function put(int next) { this.stored = next; require(true); }
+  function readValue() external returns (int) { return this.stored; }
+}`;
+    const options = {
+      messageBus: true, messageBusKernel: true, optimizeForCompilationSpeed: true, suppressWarnings: true,
+    } as never;
+    const first = compileString(source, options);
+    const second = compileString(source, options);
+    // Body-once: the second compile emits the same program and leaves no usage plan behind.
+    expect(second.bytecode).toBe(first.bytecode);
+    expect(getCompilerCacheSizes().probePlans).toBe(0);
+    // A legacy single-function contract still caches its plan and reuses it on the next compile.
+    const legacySource = `pragma solidcash ^0.14.0;
+contract LegacyPlan {
+  int public stored;
+  function put(int next) { this.stored = next; require(true); }
+}`;
+    const legacyOptions = { messageBus: false, optimizeForCompilationSpeed: true, suppressWarnings: true } as never;
+    const legacyFirst = compileString(legacySource, legacyOptions);
+    const legacySecond = compileString(legacySource, legacyOptions);
+    expect(legacySecond.bytecode).toBe(legacyFirst.bytecode);
+    const sizes = getCompilerCacheSizes();
+    expect(sizes.probePlans).toBe(1);
+    expect(sizes.probePlans).toBeLessThanOrEqual(sizes.limits.probePlans);
+    clearCompileCache();
+    expect(getCompilerCacheSizes().probePlans).toBe(0);
+  });
+
+  it('admits a framed contract without a discarded admission pass', () => {
+    const source = `pragma solidcash ^0.14.0;
+interface IStore { function read() external returns (int); }
+contract Caller(address store) {
+  function twice() external {
+    int first = IStore(store).read();
+    int second = IStore(store).read();
+    require(first == second);
+  }
+}`;
+    const attempts: { failures: unknown[] } = { failures: [] };
+    const artifact = compileString(source, {
+      composition: 'framed',
+      messageBus: true,
+      messageBusKernel: true,
+      optimizeForCompilationSpeed: true,
+      suppressWarnings: true,
+      __attemptFailureBox: attempts,
+    } as never);
+    expect(artifact.bytecode.length).toBeGreaterThan(0);
+    expect(artifact.composition?.convention).toBe('framed');
+    // The framed probe is quiet: a refused route leaves no recorded admission attempt behind.
+    expect(attempts.failures).toEqual([]);
+  });
+});
