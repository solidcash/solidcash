index 000000000..3b6681c5b
--- /dev/null
+++ b/packages/solidcash/test/deterministic-random.ts
@@ -0,0 +1,57 @@
+/**
+ * Deterministic randomness for byte-identity tests. One generator seeded from a name replaces `Math.random` and
+ * `crypto.getRandomValues`, and the SDK's process-global outpoint counters restart (`randomUtxo`'s txids and the
+ * mock fee funder's dummy coins), so a seeded test builds the same transactions whatever ran before it. Draws are
+ * counted, so a changed sequence is reported as such rather than as a byte mismatch.
+ */
+import { vi } from 'vitest';
+import { sha256 } from '@solidcash/utils';
+import * as feeFunding from '../src/stateful/stb-measure-and-fund-covenant-fee.js';
+import * as utils from '../src/utils.js';
+
+export interface SeededRandom {
+  /** Values drawn since the seed: one per `Math.random` call and one per `getRandomValues` call. */
+  draws(): number;
+  restore(): void;
+}
+
+/** mulberry32: a small, well-mixed 32-bit generator; only its determinism matters here. */
+function generatorFrom(seed: number): () => number {
+  let state = seed >>> 0;
+  return (): number => {
+    state = (state + 0x6d2b79f5) >>> 0;
+    let mixed = Math.imul(state ^ (state >>> 15), 1 | state);
+    mixed = (mixed + Math.imul(mixed ^ (mixed >>> 7), 61 | mixed)) ^ mixed;
+    return ((mixed ^ (mixed >>> 14)) >>> 0) / 4_294_967_296;
+  };
+}
+
+export function seedRandom(name: string): SeededRandom {
+  const digest = sha256(new TextEncoder().encode(name));
+  const next = generatorFrom(digest[0]! | (digest[1]! << 8) | (digest[2]! << 16) | (digest[3]! << 24));
+  let draws = 0;
+  // The base commit lacks the reset exports; a fresh process starts its counters at 0 the same way.
+  (utils as { resetUniqueTxidCounter?: () => void }).resetUniqueTxidCounter?.();
+  (feeFunding as { resetMockFeeFunderNonce?: () => void }).resetMockFeeFunderNonce?.();
+  const random = vi.spyOn(Math, 'random').mockImplementation(() => {
+    draws += 1;
+    return next();
+  });
+  const values = vi.spyOn(globalThis.crypto, 'getRandomValues').mockImplementation(<T extends ArrayBufferView | null>(
+    array: T,
+  ): T => {
+    draws += 1;
+    if (array !== null) {
+      const bytes = new Uint8Array(array.buffer, array.byteOffset, array.byteLength);
+      for (let index = 0; index < bytes.length; index += 1) bytes[index] = Math.floor(next() * 256);
+    }
+    return array;
+  });
+  return {
+    draws: () => draws,
+    restore: (): void => {
+      random.mockRestore();
+      values.mockRestore();
+    },
+  };
+}
