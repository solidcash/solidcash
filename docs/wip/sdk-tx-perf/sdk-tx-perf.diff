+/** `count` vout-0 coins at `signer`, each created by a broadcast transaction from a deterministic seed coin. */
+export async function fundFromTransactions(
+  inner: MockNetworkProvider, provider: NetworkProvider, signer: Signer, count: number, satoshis: bigint,
+): Promise<void>;
