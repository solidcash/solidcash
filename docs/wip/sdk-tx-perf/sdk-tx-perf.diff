+export type Phase2LoopExit = 'continue' | 'break' | 'oscillation';
+
+/** DESIGN 7.4: only a run that suppressed nothing can end the loop or report oscillation. */
+export function phase2LoopExit(parts: {
+  suppressed: boolean;
+  anyProbeHadError: boolean;
+  nestedPinProgress: number;
+  convergenceKey: string;
+  prevConvergenceKey: string;
+  needsPassingProbe: boolean;
+  seenConvergenceKeys: ReadonlySet<string>;
+}): Phase2LoopExit {
+  if (parts.suppressed) return 'continue';
+  if (!parts.anyProbeHadError && parts.nestedPinProgress === 0) return 'break';
