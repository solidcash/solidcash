+/**
+ * A provider the SDK treats as a live network, for tests that must take the live derivation path on mocknet: no
+ * published consensus limits and no simulator ledger, over a MockNetworkProvider that still validates every
+ * transaction it is sent.
+ */
+import { binToHex, utf8ToBin } from '@bitauth/libauth';
+import { sha256 } from '@solidcash/utils';
+import { Signer, TransactionBuilder } from '../src/index.js';
+import MockNetworkProvider from '../src/network/MockNetworkProvider.js';
+import type NetworkProvider from '../src/network/NetworkProvider.js';
+import type { ConsensusLimits } from '../src/network/NetworkProvider.js';
+
+/**
+ * BCH-2026 standard limits for the inner mock's own submit check. mem-cash accepts only integer hash-digest
+ * allowances, so the real 0.5 (standard) and 3.5 (consensus) per byte are rounded up; the SDK sees no published
+ * limits on the live-like provider and checks libauth's real values itself.
+ */
+export const STANDARD_LIMITS: ConsensusLimits = {
+  maximumInputBytes: 10_000,
+  maximumStackItemBytes: 10_000,
+  maximumTransactionBytes: 100_000,
+  maximumNftCommitmentBytes: 128,
+  operationCostBudgetPerByte: 800,
+  hashDigestIterationsPerByte: 4,
+  hashDigestIterationsPerByteStandard: 1,
+  hashDigestIterationsPerByteNonstandard: 4,
+};
+
+/**
+ * A MockNetworkProvider the SDK sees as a live network: no published limits, no simulator ledger. Coins must come
+ * from transactions it serves (own-coin.ts proves them by txid), which `fundFromTransactions` provides.
+ */
+export function liveLikeProvider(): { inner: MockNetworkProvider; provider: NetworkProvider } {
+  const inner = new MockNetworkProvider({ consensusLimits: STANDARD_LIMITS });
+  const provider = new Proxy(inner, {
+    get(target, key): unknown {
+      if (key === 'simulator') return false;
+      if (key === 'consensusLimits' || key === 'getLedgerOutput') return undefined;
+      const value: unknown = Reflect.get(target, key, target);
+      return typeof value === 'function' ? value.bind(target) : value;
+    },
+  }) as unknown as NetworkProvider;
+  return { inner, provider };
+}
+
+const FAUCET_KEY = new Uint8Array(32).fill(0xfa);
+
+/** `count` vout-0 coins at `signer`, each created by a broadcast transaction from a deterministic seed coin. */
+export async function fundFromTransactions(
+  inner: MockNetworkProvider, provider: NetworkProvider, signer: Signer, count: number, satoshis: bigint,
+): Promise<void> {
+  const faucet = new Signer(FAUCET_KEY, provider);
+  for (let index = 0; index < count; index += 1) {
+    const seed = {
+      txid: binToHex(sha256(utf8ToBin(`live-like-seed-${index}`))), vout: 0, satoshis: satoshis + 2_000n,
+    };
+    await inner.addUtxo(faucet.getAddress(), seed);
+    // A plain P2PKH spend makes no own-coin proof, so the seed needs no transaction of its own.
+    const builder = new TransactionBuilder({ provider });
+    builder.addInput(seed, faucet.unlockP2PKH());
+    builder.addOutput({ to: signer.getLockingBytecode(), amount: satoshis });
+    await builder.send();
+  }
+}
diff --git a/packages/solidcash/test/unit/LiveLimitProbeVm.test.ts b/packages/solidcash/test/unit/LiveLimitProbeVm.test.ts
new file mode 100644
index 000000000..b41b62fc5
--- /dev/null
+++ b/packages/solidcash/test/unit/LiveLimitProbeVm.test.ts
@@ -0,0 +1,254 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import {
+  binToHex, createVirtualMachineBch2026, decodeTransactionUnsafe, encodeDataPush, encodeTransactionBch,
+  flattenBinArray, hash256, hexToBin,
+} from '@bitauth/libauth';
+import type { AuthenticationProgramStateCommon } from '@bitauth/libauth';
+import { OpcodesBch2026 as Op } from '@bitauth/libauth/build/lib/vm/instruction-sets/bch/2026/bch-2026-opcodes.js';
+import MockNetworkProvider from '../../src/network/MockNetworkProvider.js';
+import RegtestNetworkProvider from '../../src/network/RegtestNetworkProvider.js';
+import type NetworkProvider from '../../src/network/NetworkProvider.js';
+import {
+  createFaithfulTraceVmForProvider, createVirtualMachineBch2026ForProvider,
+} from '../../src/network/createVirtualMachine.js';
+import {
+  evaluateFaithfulProbeTrace, evaluateProbeTrace, evaluateSuppressedProbeTrace, reduceProbeTrace,
+  type ProbeProgram,
+} from '../../src/stateful/faithful-probe-trace.js';
+import { extractCommitmentMapFromTrace } from '../../src/stateful/trace-commitment-helpers.js';
+import { STANDARD_LIMITS } from '../live-like-provider.js';
+
+/**
+ * The probe instruments on providers without the SDK's fast VM paths: a live network (no published limits) and a
+ * non-simulator publishing standard limits, with the fast mock as control. The recorder must equal `debug()` state
+ * for state, the sparse observer must stop where `debug()` stops with the same cost, and a suppressing wrapper must
+ * never reach a faithful caller.
+ */
+
+type Part = number | Uint8Array;
+type State = AuthenticationProgramStateCommon & { functionCount?: number; operationCount?: number };
+
+const AA = Uint8Array.of(0xaa);
+const BB = Uint8Array.of(0xbb);
+const CATEGORY = new Uint8Array(32).fill(0xcc);
+
+/** Opcodes as themselves, byte strings as minimal pushes. */
+const script = (...parts: Part[]): Uint8Array =>
+  flattenBinArray(parts.map((part) => (typeof part === 'number' ? Uint8Array.of(part) : encodeDataPush(part))));
+
+/** A P2SH32 spend of `redeem` at input 0; output 0 carries an NFT with `commitment`. */
+function programWith(unlocking: Uint8Array, redeem: Uint8Array, commitment: Uint8Array = AA): ProbeProgram {
+  const locking = flattenBinArray([Uint8Array.of(Op.OP_HASH256, 0x20), hash256(redeem), Uint8Array.of(Op.OP_EQUAL)]);
+  const transaction = decodeTransactionUnsafe(encodeTransactionBch({
+    version: 2,
+    inputs: [{
+      outpointTransactionHash: hexToBin('11'.repeat(32)), outpointIndex: 0, sequenceNumber: 0xffffffff,
+      unlockingBytecode: unlocking,
+    }],
+    outputs: [{
+      lockingBytecode: Uint8Array.of(Op.OP_1), valueSatoshis: 1_000n,
+      token: { amount: 0n, category: CATEGORY, nft: { capability: 'none', commitment } },
+    }],
+    locktime: 0,
+  }));
+  return { inputIndex: 0, sourceOutputs: [{ lockingBytecode: locking, valueSatoshis: 10_000n }], transaction } as
+    unknown as ProbeProgram;
+}
+
+const p2sh = (redeem: Uint8Array, commitment: Uint8Array = AA): ProbeProgram =>
+  programWith(encodeDataPush(redeem), redeem, commitment);
+
+const outlined = script(
+  Uint8Array.of(Op.OP_EQUALVERIFY), Op.OP_1, Op.OP_DEFINE,
+  Op.OP_0, Op.OP_OUTPUTTOKENCOMMITMENT, AA, Op.OP_1, Op.OP_INVOKE, Op.OP_1,
+);
+
+const PROGRAMS: Record<string, ProbeProgram> = {
+  OUTLINED_FAIL: p2sh(outlined, BB),
+  OUTLINED_PASS: p2sh(outlined, AA),
+  INACTIVE_PIN: p2sh(script(
+    Op.OP_0, Op.OP_IF, Op.OP_0, Op.OP_OUTPUTTOKENCOMMITMENT, Uint8Array.of(0x02), Op.OP_EQUALVERIFY,
+    Op.OP_ELSE, Op.OP_0, Op.OP_OUTPUTTOKENCOMMITMENT, AA, Op.OP_EQUALVERIFY, Op.OP_ENDIF, Op.OP_1,
+  )),
+  LOOP: p2sh(script(
+    Op.OP_3, Op.OP_BEGIN, Op.OP_0, Op.OP_OUTPUTVALUE, Op.OP_DROP, Op.OP_1SUB, Op.OP_DUP, Op.OP_NOT, Op.OP_UNTIL,
+    Op.OP_DROP, Op.OP_1,
+  )),
+  // A second OP_ELSE toggles the branch again: the third arm runs.
+  MULTI_ELSE: p2sh(script(
+    Op.OP_1, Op.OP_IF, Op.OP_NOP, Op.OP_ELSE, Op.OP_NOP, Op.OP_ELSE, Op.OP_0, Op.OP_OUTPUTVALUE, Op.OP_ENDIF,
+    Op.OP_DROP, Op.OP_1,
+  )),
+  // An inactive OP_UNTIL pops a loop marker; this one meets the conditional's frame and fails even unexecuted.
+  LOOP_ACROSS_BRANCH: p2sh(script(
+    Op.OP_BEGIN, Op.OP_0, Op.OP_IF, Op.OP_UNTIL, Op.OP_ENDIF, Op.OP_1, Op.OP_UNTIL, Op.OP_1,
+  )),
+  // Inactive conditionals still push control frames: stepping these passes the 100-frame limit.
+  DEEP_INACTIVE: p2sh(script(
+    Op.OP_0, Op.OP_IF, ...Array<number>(100).fill(Op.OP_IF), ...Array<number>(100).fill(Op.OP_ENDIF), Op.OP_ENDIF,
+    Op.OP_1,
+  )),
+  MALFORMED_P2SH: p2sh(Uint8Array.of(Op.OP_PUSHDATA_1)),
+  NON_PUSH_UNLOCKING: programWith(Uint8Array.of(Op.OP_1, Op.OP_DUP), Uint8Array.of(Op.OP_1)),
+};
+
+const live = (): NetworkProvider => new RegtestNetworkProvider();
+const limited = (): NetworkProvider => new RegtestNetworkProvider({ consensusLimits: STANDARD_LIMITS });
+const fast = (): NetworkProvider => new MockNetworkProvider({ consensusLimits: STANDARD_LIMITS });
+
+const frameOf = (frame: unknown): unknown => (typeof frame === 'object' && frame !== null
+  ? { ip: (frame as { ip: number }).ip, instructions: (frame as { instructions: unknown[] }).instructions.length }
+  : frame);
+
+/** Everything a faithful trace consumer can read from one state, except the shared function table. */
+const projection = (state: State): Record<string, unknown> => ({
+  ip: state.ip,
+  instructions: state.instructions.length,
+  error: state.error,
+  stack: state.stack.map((item) => binToHex(item)),
+  alternateStack: state.alternateStack.map((item) => binToHex(item)),
+  controlStack: state.controlStack.map(frameOf),
+  functionCount: state.functionCount,
+  metrics: JSON.stringify(state.metrics),
+  operationCount: state.operationCount,
+  lastCodeSeparator: state.lastCodeSeparator,
+  signedMessages: state.signedMessages.length,
+});
+
+const debugOf = (provider: NetworkProvider, program: ProbeProgram): State[] =>
+  createVirtualMachineBch2026ForProvider(provider).debug(program) as State[];
+
+const failedEqualVerifyCleared = (calls: { count: number }) => (
+  opcode: number, state: unknown, operation: (state: never) => unknown,
+): unknown => {
+  const next = operation(state as never) as { error?: string };
+  if (opcode !== Op.OP_EQUALVERIFY || next.error === undefined) return next;
+  calls.count += 1;
+  const cleared = { ...next };
+  delete cleared.error;
+  return cleared;
+};
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+  vi.restoreAllMocks();
+});
+
+describe('probe instruments without the fast VM paths', () => {
+  it('records the same trace as debug() on every provider', () => {
+    for (const provider of [live(), limited(), fast()]) {
+      for (const [name, program] of Object.entries(PROGRAMS)) {
+        const reference = debugOf(provider, program).map(projection);
+        const recorded = (evaluateFaithfulProbeTrace(provider, program) as State[]).map(projection);
+        expect(recorded, name).toEqual(reference);
+      }
+    }
+  });
+
+  it('reports exactly the phase exits debug() records', () => {
+    const exits = (provider: NetworkProvider, program: ProbeProgram): number => {
+      let count = 0;
+      createFaithfulTraceVmForProvider(provider, () => {}, () => { count += 1; }).evaluate(program);
+      return count;
+    };
+    for (const provider of [live(), limited(), fast()]) {
+      expect(exits(provider, PROGRAMS.OUTLINED_PASS!)).toBe(3);
+      expect(exits(provider, PROGRAMS.MALFORMED_P2SH!)).toBe(2);
+      expect(exits(provider, PROGRAMS.NON_PUSH_UNLOCKING!)).toBe(0);
+    }
+    const observerless = createVirtualMachineBch2026ForProvider(live()).evaluate(PROGRAMS.OUTLINED_FAIL!) as State;
+    const stock = createVirtualMachineBch2026(true).evaluate(PROGRAMS.OUTLINED_FAIL! as never) as State;
+    expect(observerless.error).toEqual(stock.error);
+    expect(observerless.stack).toEqual(stock.stack);
+    expect(observerless.metrics).toEqual(stock.metrics);
+  });
+
+  it('stops the sparse observer where debug() stops, at the same cost, observing no inactive state', () => {
+    const cases = ['INACTIVE_PIN', 'LOOP', 'MULTI_ELSE', 'LOOP_ACROSS_BRANCH', 'DEEP_INACTIVE'];
+    for (const provider of [live(), limited()]) {
+      for (const name of cases) {
+        const program = PROGRAMS[name]!;
+        const sparse = evaluateProbeTrace(provider, program) as State[];
+        const final = debugOf(provider, program).at(-1)!;
+        const terminal = sparse.at(-1)!;
+        // A run may end inside an inactive branch; only the observations must come from active code.
+        expect(sparse.slice(0, -1).some((state) => state.controlStack.some((frame) => frame === false)), name)
+          .toBe(false);
+        expect(terminal.error, name).toEqual(final.error);
+        expect(binToHex(terminal.stack.at(-1) ?? Uint8Array.of()), name)
+          .toBe(binToHex(final.stack.at(-1) ?? Uint8Array.of()));
+        expect(terminal.metrics.evaluatedInstructionCount, name).toBe(final.metrics.evaluatedInstructionCount);
+        expect(terminal.metrics.operationCost, name).toBe(final.metrics.operationCost);
+      }
+      const multiElse = evaluateProbeTrace(provider, PROGRAMS.MULTI_ELSE!) as State[];
+      expect(multiElse.at(-1)!.error).toBeUndefined();
+      expect(multiElse.filter((state) => state.instructions[state.ip]?.opcode === Op.OP_OUTPUTVALUE)).toHaveLength(1);
+      expect(evaluateProbeTrace(provider, PROGRAMS.LOOP_ACROSS_BRANCH!).at(-1)!.error).toBeDefined();
+      expect(evaluateProbeTrace(provider, PROGRAMS.DEEP_INACTIVE!).at(-1)!.error).toBeDefined();
+    }
+  });
+
+  it('holds both instruments to debug() under the parity diagnostic', () => {
+    vi.stubEnv('SOLIDC_DEBUG_TRACE_PARITY', '1');
+    const logged = vi.spyOn(console, 'error').mockImplementation(() => {});
+    const provider = live();
+    for (const program of Object.values(PROGRAMS)) {
+      evaluateProbeTrace(provider, program);
+      evaluateProbeTrace(provider, program, true);
+    }
+    const records = logged.mock.calls.filter(([tag]) => tag === 'probe-trace-parity')
+      .map(([, record]) => record as { equal: unknown; mode: string });
+    expect(records.filter((record) => record.equal !== true)).toEqual([]);
+    expect(records.some((record) => record.mode === 'sparse')).toBe(true);
+    expect(records.some((record) => record.mode === 'recorder')).toBe(true);
+  });
+
+  it('returns the reduced recorder trace when forced, equal to the reduced debug() trace', () => {
+    const provider = live();
+    for (const [name, program] of Object.entries(PROGRAMS)) {
+      const forced = (evaluateProbeTrace(provider, program, true) as State[]).map(projection);
+      const reduced = (reduceProbeTrace(debugOf(provider, program)) as State[]).map(projection);
+      expect(forced, name).toEqual(reduced);
+    }
+  });
+
+  it('extracts the same pins from the sparse trace as from the reduced debug() trace', () => {
+    const provider = live();
+    const pins = (trace: AuthenticationProgramStateCommon[]): Record<number, string> =>
+      Object.fromEntries(extractCommitmentMapFromTrace(trace));
+    expect(pins(evaluateProbeTrace(provider, PROGRAMS.OUTLINED_FAIL!))).toEqual({ 0: 'aa' });
+    expect(pins(reduceProbeTrace(debugOf(provider, PROGRAMS.OUTLINED_FAIL!)))).toEqual({ 0: 'aa' });
+    expect(Object.values(pins(evaluateProbeTrace(provider, PROGRAMS.INACTIVE_PIN!)))).not.toContain('02');
+  });
+
+  it('keeps a suppressing wrapper on the collector VM, for one evaluation, and refuses reentry', () => {
+    const provider = live();
+    const program = PROGRAMS.OUTLINED_FAIL!;
+    const failsFaithfully = (): void => {
+      expect(evaluateProbeTrace(provider, program).at(-1)!.error).toBeDefined();
+      expect(evaluateFaithfulProbeTrace(provider, program).at(-1)!.error).toBeDefined();
+    };
+    failsFaithfully();
+    const calls = { count: 0 };
+    const suppressed = evaluateSuppressedProbeTrace(provider, program, failedEqualVerifyCleared(calls));
+    expect(suppressed!.at(-1)!.error).toBeUndefined();
+    expect(calls.count).toBe(1);
+    failsFaithfully();
+
+    expect(() => evaluateSuppressedProbeTrace(provider, program, () => {
+      throw new Error('wrapper failed');
+    })).toThrow('wrapper failed');
+    expect(() => evaluateSuppressedProbeTrace(provider, program, (opcode, state, operation) => {
+      evaluateSuppressedProbeTrace(provider, program, failedEqualVerifyCleared({ count: 0 }));
+      return operation(state as never);
+    })).toThrow(/nested evaluation on the collector VM/);
+    failsFaithfully();
+    const again = { count: 0 };
+    expect(evaluateSuppressedProbeTrace(provider, program, failedEqualVerifyCleared(again))!.at(-1)!.error)
+      .toBeUndefined();
+    expect(again.count).toBe(1);
+
+    vi.stubEnv('SC_FORCE_FULL_PROBE_TRACE', '1');
+    expect(evaluateSuppressedProbeTrace(provider, program, failedEqualVerifyCleared({ count: 0 }))).toBeUndefined();
+  });
+});
