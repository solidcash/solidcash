+  const categories = stb.collectorParticipantCategories();
+  const ownsOutput = (outputIndex: number): boolean => {
+    const output = probe.outputs[outputIndex];
+    const token = output?.token;
+    if (output === undefined || token?.nft === undefined || token.nft.capability === 'minting') return false;
+    if (!categories.has(token.category.toLowerCase()) || stb.isUserOutput(output)) return false;
+    return !isScidIdentityCommitment(token.nft.commitment);
