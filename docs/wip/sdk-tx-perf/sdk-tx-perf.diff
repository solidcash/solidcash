+## 2. `framed/composer/draft.ts`: layered learning
+
+### 2.1 State added inside `composeDraft` (after `:592`)
+
+```ts
+/** A value a walk learned past its first close: re-learnable until a passed close on it confirms it (3.0). */
+type ProvisionalSlot =
+  /**
+   * `sites`: the entries this value was written into, so a re-learn or a revert moves exactly these (`ViewSites`,
+   * `:886`). `placeholder`: what the slot held before it was first learned, which a revert writes back.
+   */
+  | {
+    readonly kind: 'view'; readonly view: UnstatedView; readonly sites: ViewSites; readonly placeholder: Uint8Array;
+  }
+  /** `settledBefore`: each input id the witness settled, with what `settled` held for it before (undefined: none). */
+  | {
+    readonly kind: 'witness'; readonly witness: DraftComputedWitness; readonly placeholder: Uint8Array;
+    readonly settledBefore: ReadonlyMap<string, DraftSettledInput | undefined>;
+  };
+/** Per master, the provisional values by the hex of the value each slot now carries. */
+const provisionalByMaster = new Map<string, Map<string, ProvisionalSlot>>();
+const provisionalOf = (master: string): Map<string, ProvisionalSlot> => { /* get or create */ };
+/** Shorter values can match an unrelated operand, so only the first close of a walk learns them (F6). */
+const DISTINCTIVE_BYTES = 20;   // module level, beside MAXIMUM_STACK_ITEM_BYTES (:96)
+const batching = !framedLegacyEnabled();   // read once per draft
+```
+
+### 2.2 `learnComputedValues` (`:922-985`), new shape
+
+The view and witness application bodies (`:950-982`) move unchanged into `applyLearned(match, current)`. That function
+returns `'refused'` for today's two `return`s (a view longer than the bound at `:951`, and a missing entry at `:953`)
+and `'applied'` otherwise.
+
+The only generalization: the key being replaced may be a placeholder, or a provisional value that is re-learned.
+- A placeholder key runs today's body (`:944-981`): it is removed from `views` (or from `unlearnedWitnesses`). With
+  `provisional: true` the value is then added to `provisionalOf(master)` under its new hex: a witness slot (with the
+  placeholder and the `settled` entries its settle replaced), or a view slot whose `sites` holds `entry` and the
+  entries of the replaced key's `sitesByView` bucket, each once, copied before the merge at `:962-968`, and whose
+  `placeholder` is the replaced key's bytes. A re-learn keeps the slot's `placeholder` and `settledBefore`.
+- A provisional key is a re-learn, and the one site that bumps `provisionalRelearned`. It is deleted from
+  `provisionalOf(master)`. A view keeps the bound check (`:945`), writes the value into exactly `slot.sites`, and moves
+  exactly those entries, by identity, from the old bytes' bucket to the new one, deleting an emptied bucket. It never
+  looks the old bytes up in `sitesByView()`: other records whose views carry equal bytes share that bucket
+  (`:953-969`). A witness calls `witness.settle` again (`:975-980`). With `provisional: true` the slot is re-added
+  under the new hex with the same `sites`.
+- A first-close value (`provisional: false`) is faithful and never enters `provisional`.
+
+```ts
+const learnComputedValues = (
+  master: string, current: WitnessBlock, step?: StepRecipe, options?: { readonly batch?: boolean },
+): LearnOutcome => {
+  const views = unstatedByMaster.get(master) ?? new Map<string, UnstatedView>();
+  const provisional = provisionalOf(master);
+  const witnessOf = (key: string): DraftComputedWitness | undefined => {
+    const witness = unlearnedWitnesses.get(key);
+    return witness?.master === master ? witness : undefined;
+  };
+  // A placeholder outranks a provisional value, so a close matches as it would if every provisional value were final.
+  const rank = (key: string): number => (views.has(key) || witnessOf(key) !== undefined ? 2
+    : provisional.has(key) ? 1 : 0);
+  const bound = Math.max(maximumCommitmentBytes, MAXIMUM_STACK_ITEM_BYTES);
+  // Today's acceptance: a plausible close with one learnable operand. Equal ranks are no close at all.
+  const matchOf = (close: ReadDeclaration): CloseMatch | undefined => {
+    if (close.computed.length === 0 || close.computed.length > bound) return undefined;
+    const declared = bytesToHex(close.declared);
+    const computed = bytesToHex(close.computed);
+    if (rank(declared) === rank(computed)) return undefined;
+    const onDeclared = rank(declared) > rank(computed);
+    return {
+      key: onDeclared ? declared : computed,
+      learned: onDeclared ? close.computed : close.declared,
+      replaced: onDeclared ? close.declared : close.computed,
+      close,
+    };
+  };
+  const pending = views.size + witnessCount(master) + provisional.size;
+  if (pending === 0) return { applied: 0, skipped: false };
+  let suppress = batching && options?.batch !== false;
+  // Section 3.0: no provisional value outlives this call. A walk that stepped nothing is faithful, so its notes settle
+  // the master's provisional values; true when something reverted, and the loop then walks again, unbatched.
+  const settled = (passed: ReadonlySet<string>): boolean =>
+    provisional.size > 0 && settleProvisional(master, current, passed) > 0;
+  const fingerprints = new Set<string>();
+  const layers: number[] = [];
+  // One walk per dependency layer and the walk that suppresses nothing; past the bound, a later step re-reads.
+  walks: for (let walk = 0; walk <= pending; walk += 1) {
+    const passedValues = new Set<string>();
+    const result = readComputedDeclarations({
+      vm: learningMachine(), program: programOf(master, current), maximumCommitmentBytes: bound,
+      // Step past only a close the base would apply: the base stops learning at one it refuses (:951, :953).
+      ...(suppress ? { authenticate: (close: ReadDeclaration): boolean => {
+        const match = matchOf(close);
+        return match !== undefined && wouldApply(match, current);
+      } } : {}),
+      ...(provisional.size > 0 ? { notePassed: (value: Uint8Array): void => { passedValues.add(bytesToHex(value)); } }
+        : {}),
+    });
+    // A walk that stepped past nothing is the faithful reading: its stop is learned from as today, one value.
+    const closes = result.closes.length > 0 ? result.closes : (result.end.ok ? [result.end] : []);
+    if (closes.length === 0) {
+      // Passed or stopped, this walk compared what it compared: settle, and walk again unbatched after a revert.
+      if (settled(passedValues)) {
+        suppress = false;
+        continue walks;
+      }
+      return { applied: layers.reduce((sum, count) => sum + count, 0), skipped: false, layers };
+    }
+    // Classify every close against the maps the walk authenticated with, before anything is applied: applying changes
+    // them, and a later close on a slot written in this walk must be skipped, not end the loop.
+    const matches = closes.map(matchOf);
+    if (matches[0] === undefined) {   // a faithful walk's stop only: suppressed closes all match
+      if (settled(passedValues)) {
+        suppress = false;
+        continue walks;
+      }
+      return { /* as above */ };
+    }
+    const decided = new Set<string>();
+    const written = new Set<string>();
+    const pairs: string[] = [];
+    for (const [position, match] of matches.entries()) {
+      if (match === undefined || decided.has(match.key)) continue;   // a slot's first close in the walk decides it
+      decided.add(match.key);
+      const later = position > 0;
+      const hex = bytesToHex(match.learned);
+      // A later value must be distinctive and carried by nothing else; otherwise a later walk reads it first.
+      if (later && (match.learned.length < DISTINCTIVE_BYTES || rank(hex) > 0 || sitesByView().has(hex)
+        || witnessOf(match.key)?.batchable === false)) continue;
+      if (applyLearned(match, current, { provisional: later }) === 'refused') {
+        if (later) continue;
+        // Only a faithful walk's end close can be refused here: `wouldApply` filtered every stepped close.
+        if (settled(passedValues)) {
+          suppress = false;
+          continue walks;
+        }
+        return { /* as above */ };
+      }
+      written.add(match.key);
+      pairs.push(`${match.key}>${hex}`);
+    }
+    layers.push(written.size);
+    bumpFramedCounter('provisionalApplied', Math.max(0, written.size - 1));
+    // A repeated candidate set means the layers do not settle: learn one value per walk from here (DESIGN 7.4).
+    const fingerprint = pairs.sort().join(',');
+    if (fingerprints.has(fingerprint)) suppress = false;
+    fingerprints.add(fingerprint);
+    if (step !== undefined && skipsConfirmation(step, layers)) {
+      // Section 5.2: only after a one-value layer, so this walk applied nothing provisional.
+      return { applied: written.size, skipped: true, layers };
+    }
+  }
+  // The bound ended the loop, perhaps after a batched walk: one faithful walk with `notePassed` settles what is left.
+  if (provisional.size > 0) settleProvisional(master, current, faithfulPassed(master, current));
+  return { applied: layers.reduce((sum, count) => sum + count, 0), skipped: false, layers };
+};
+```
+
+Notes:
+- `applyLearned(..., { provisional })` is described above. A first-close value that re-learns a provisional key removes
+  it from `provisional` (a faithful re-learn).
+- `wouldApply(match, current)` mirrors `applyLearned`'s two refusals: a view key needs `match.learned.length <=
+  maximumCommitmentBytes` (`:945`) and its entry (`:947`). `matchOf` alone accepts views up to `bound` (10,000 bytes),
+  so without it a walk would step past a close where the base stops learning and go on to learn later closes.
+- `settleProvisional(master, current, passedValues)` returns how many slots it reverted. It is the draft's call of an
+  exported pure helper, `settleProvisionalSlots(state, passed)` in a new `framed/composer/provisional.ts`, over
+  `state = { provisional, views, unlearnedWitnesses, sitesByView, settled }`, so a unit test can build them (7.4.6).
+  Each of the master's provisional slots is:
+  - confirmed, and removed from `provisional`, when its value's hex is in `passed`. Equal bytes elsewhere do not
+    block it: a later segment that keeps the record unchanged learns the same bytes as a first close and joins the
+    bucket, and both closes pass;
+  - otherwise reverted, and `provisionalReverted` is bumped. A view writes `placeholder` back into exactly its `sites`
+    (each entry's `viewIn` or `viewOut`, as the bucket lists it), moves those entries to the placeholder's bucket, and
+    re-adds `views.set(placeholderHex, slot.view)`. A witness re-adds `unlearnedWitnesses.set(placeholderHex,
+    slot.witness)` and puts `settledBefore` back into `settled` (deleting an id whose earlier value is undefined).
+- `faithfulPassed(master, current)` reads `programOf(master, current)` with no `authenticate` and with `notePassed`,
+  and returns what it passed.
+- No provisional value outlives the call that learned it: every exit settles from a faithful walk. So no other master
+  ever reads an unconfirmed value, and nothing needs settling later.
+- Which slots can revert: every segment close checks every record its segment declares (solidc
+  `generation/GenerateTargetTraversal.ts:33028`, the kept check at `framed/master/declared-view.ts:628`), and a passing
+  run runs every segment its plan fills, so a passing walk compares every declared view. A view reverts only when the
