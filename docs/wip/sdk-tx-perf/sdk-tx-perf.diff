+  maximumNftCommitmentBytes: 128, operationCostBudgetPerByte: 800, hashDigestIterationsPerByte: 4,
+  hashDigestIterationsPerByteStandard: 1, hashDigestIterationsPerByteNonstandard: 4,
+};
+// mem-cash accepts only integer hash-digest allowances (MockNetworkProvider.ts:366-370), so the real 0.5 and 3.5
+// are rounded up; the SDK sees no published limits on the live-like provider and checks libauth's real values.
