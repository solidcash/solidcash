+
+```ts
+const passedValues = new Set<string>();
+const rootRead = readComputedDeclarations({
+  vm: machine, program: rootProgram, maximumCommitmentBytes,
+  // The last attempt the bound allows is clean (section 3.0).
+  ...(rootBatching && attempt < maximumAttempts - 1
+    ? { authenticate: (close: ReadDeclaration): boolean => rootLearningOf(close) !== undefined } : {}),
+  ...(pending() ? { notePassed: (value: Uint8Array): void => { passedValues.add(bytesToHex(value)); } } : {}),
+});
+if (rootRead.closes.length > 0) {
+  // A close on a slot still speculative: that value failed its close, so restore (section 3.0).
+  if (rootRead.closes.some((close) => speculative.has(rootLearningOf(close)!.slot))) { restore; continue; }
+  const { applied, later } = applyRootLearnings(rootRead.closes, candidate);
+  for (const [slot, value] of later) speculative.set(slot, value);
+  if (later.length > 0) origin ??= { state: attemptStart!, attempt };
