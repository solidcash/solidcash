+    else recordComputedOutputRepairTransition(history, inputIndex, coordinate, repair.proposed);
+  }
+}
+
+/**
+ * Record a sweep state. A state revisited after a suppressing round resets both cycle detectors and returns true
+ * (finish faithfully); a state revisited after a faithful round throws as today.
+ */
+export function admitRepairSweepState(
+  states: Set<string>, history: Map<string, string>, fingerprint: string, roundSuppressed: boolean,
+): boolean {
+  const reset = roundSuppressed && states.has(fingerprint);
+  if (reset) {
+    states.clear();
+    history.clear();
+  }
+  recordComputedOutputConvergenceState(states, fingerprint);
+  return reset;
+}
+```
+Exits: `return transaction` only after a passing `assertFinalizedTransactionCovenants` (`:272`), the whole-transaction
+faithful verdict; throws are today's (`lastError` from that preflight, exhaustion, geometry). So this loop's own
+clean exit is structural, and it does not touch the STB mark. `repairsRemaining` and `repairPassLimit` count every
+repair and sweep, suppressing or clean, and the last of each runs clean (SPEC L1). The geometry budget is unchanged.
+
