+export function stbCollectorSession(
+  stb: Pick<StatefulTransactionBuilder,
+    'collectorParticipantCategories' | 'collectorTransferOutputIndices' | 'isUserOutput'>,
+  probe: Pick<TransactionBuilder, 'outputs'>,
+  options: { values: boolean },
