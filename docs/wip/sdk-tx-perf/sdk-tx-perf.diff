+## Change G - parity diagnostics and test sink
+
+**File** `stateful/faithful-probe-trace.ts` (replace the parity block `:987-991`; extend `logProbeTraceParity`
+`:236`).
+
+**New code shape.**
+
+```ts
+/** One probe the parity diagnostic compared; `reference` is `debug()`'s whole trace. */
+export interface ProbeTraceParitySample {
+  readonly mode: 'sparse' | 'recorder';
+  readonly program: ProbeProgram;
+  readonly candidate: readonly AuthenticationProgramStateCommon[];
+  readonly reference: readonly AuthenticationProgramStateCommon[];
+}
+let paritySink: ((sample: ProbeTraceParitySample) => void) | undefined;
+
+/** Test hook: receive each probe `SOLIDC_DEBUG_TRACE_PARITY=1` compares; `undefined` stops. Diagnostic only. */
+export function setProbeTraceParitySink(sink: ((sample: ProbeTraceParitySample) => void) | undefined): void {
+  paritySink = sink;
+}
+
+function parityReference(
+  provider: NetworkProvider, program: ProbeProgram, mode: ProbeTraceParitySample['mode'],
+): AuthenticationProgramStateCommon[] | undefined {
+  try {
+    return cachedDebugVm(provider).debug(program) as AuthenticationProgramStateCommon[];
+  } catch (error) {
+    console.error('probe-trace-parity', { equal: 'skipped', mode, reason: String(error).slice(0, 200) });
+    return undefined;
+  }
+}
+
+function logRecorderParity(
+  provider: NetworkProvider, program: ProbeProgram, recorded: AuthenticationProgramStateCommon[],
+): void {
+  const reference = parityReference(provider, program, 'recorder');
+  if (reference === undefined) return;
+  logProbeTraceParity(reference, recorded, 'recorder');
+  paritySink?.({ mode: 'recorder', program, candidate: recorded, reference });
+}
+
+/**
+ * Replay `debug()`'s executed, active probe-opcode states through a fresh collector. An observer that saw the same
+ * operations produces exactly that trace, so a difference is an observer defect, not a projection.
+ */
+function logSparseParity(
+  provider: NetworkProvider, program: ProbeProgram, sparse: AuthenticationProgramStateCommon[],
+): void {
+  const reference = parityReference(provider, program, 'sparse');
+  if (reference === undefined) return;
+  const replay = new BoundedProbeTraceCollector();
+  for (const state of reference.slice(0, -1)) {
+    const opcode = state.instructions[state.ip]?.opcode;
+    // An operation runs only on an error-free state; a phase's last state points past its final instruction.
+    if (state.error !== undefined || opcode === undefined || !PROBE_TRACE_OPCODES.has(opcode)) continue;
+    replay.observe(state);
+  }
+  logProbeTraceParity(replay.finish(reference[reference.length - 1]!), sparse, 'sparse');
+  paritySink?.({ mode: 'sparse', program, candidate: sparse, reference });
+}
+```
+
+`logProbeTraceParity(reference, candidate, mode)`: add `mode` to every log record. `describe` keeps ip, instruction
+count, error, stack, alternate stack, control depth for both modes; for `'recorder'` also `functionCount`,
+`metrics` (JSON), `operationCount`, `lastCodeSeparator`, `signedMessages.length`. Not for `'sparse'`: a sparse
+snapshot spreads the live `metrics` object (`projectState`, `:471`), which later operations mutate. Never compare
+`functionTable`: the recorder shares the live table (`snapshotProgramState`, `:139`) while the fork's `debug()`
+copies on write (`isFunctionTableShared`, `bch-2026-functions.js`), so a historical recorder state can list later
+definitions.
+
+**Why the replay is exact.** The VM calls `beforeOperation` with the state before each executed op. In `debug()` that
+state is the previous op's result (after `continue` popped any finished `OP_INVOKE` frame in place), or the phase's
+initial state for the first op. States not followed by an op are the phase's last (ip past the end, or an error),
+which the filter drops. Change F removes inactive states on both sides; `observe` applies the
+awaiting/identity-pin rule itself. `finish(reference final)` builds the same evidence and terminal entries from the
+same items.
+
+**Invariant.** Never runs on suppressing evaluations. Returned traces are unaffected.
+
