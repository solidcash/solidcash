diff --git a/packages/solidcash/test/e2e/LiveLimitProbeParity.test.ts b/packages/solidcash/test/e2e/LiveLimitProbeParity.test.ts
new file mode 100644
index 000000000..3db0dfbc1
--- /dev/null
+++ b/packages/solidcash/test/e2e/LiveLimitProbeParity.test.ts
@@ -0,0 +1,322 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import {
+  binToHex, decodeAuthenticationInstructions, hexToBin, OpcodesBCH, type AuthenticationProgramStateCommon,
+} from '@bitauth/libauth';
+import { Signer } from '../../src/index.js';
+import type { TransactionDetails } from '../../src/interfaces.js';
+import type NetworkProvider from '../../src/network/NetworkProvider.js';
+import { usesFastVmPaths } from '../../src/network/createVirtualMachine.js';
+import { runMockNetworkProviderResetHooks } from '../../src/network/mock-reset.js';
+import { getContractFactory } from '../../src/stateful/index.js';
+import {
+  evaluateFaithfulProbeTrace, reduceProbeTrace, setProbeTraceParitySink, type ProbeTraceParitySample,
+} from '../../src/stateful/faithful-probe-trace.js';
+import { extractHashedReturnCommitmentAtOutput } from '../../src/stateful/hashed-return-probe.js';
+import {
+  extractCommitmentMapFromTrace, extractFailingValueChunkCommitments, extractPendingReturnCommitment,
+  extractPendingReturnCommitmentAtOutput,
+} from '../../src/stateful/trace-commitment-helpers.js';
+import { extractVerifiedValuesFromTrace } from '../../src/stateful/trace-verified-value-helpers.js';
+import { scanKeccakPreimageReads } from '../../src/keccak/keccakComputeSidecar.js';
+import { compileString } from '../direct-compile.js';
+import { seedRandom } from '../deterministic-random.js';
+import { fundFromTransactions, liveLikeProvider } from '../live-like-provider.js';
+
+/**
+ * Derivation flows on a provider the SDK treats as a live network (no published limits, no simulator), mocknet
+ * only. Today's live instruments (`debug()` for every probe) and the sparse observer must settle byte-identical
+ * transactions, and the parity diagnostic must find every sparse and recorder trace equal to `debug()`'s.
+ */
+
+type State = AuthenticationProgramStateCommon & { functionCount?: number; operationCount?: number };
+type Shape = 'S1' | 'S2' | 'S3' | 'S4' | 'S5';
+type Handle = Record<string, (...args: unknown[]) => { send: () => Promise<unknown> }>;
+
+// S1: a modifier increments state before its body; with this many writes the commitment check is outlined
+// (the source of `OutlinedCommitmentVerify.test.ts`).
+const OUTLINED = `
+contract Counter {
+  uint256 public x = 0;
+  modifier bumpThenZero(uint256 a, uint256 b) {
+    x++;
+    _;
+    require(a == 0, "a is not zero");
+    require(b == 0, "b is not zero");
+  }
+  function triple() public bumpThenZero(r1, r3) returns (uint256 r1, uint256 r2, uint256 r3) {
+    r1 = 16;
+    r2 = 32;
+    r3 = 64;
+  }
+  function fails(uint256 i) public bumpThenZero(i, r + 20) returns (uint256 r) { r = 0; }
+  function nested() bumpThenZero(r, r) bumpThenZero(r, r) bumpThenZero(r + r, r - r) bumpThenZero(r * r, r & r)
+    public returns (uint256 r) { r = x; }
+}
+contract Probe is Counter {
+  function callTriple(uint256 e0, uint256 e1, uint256 e2, bool cmp) public {
+    (uint256 r0, uint256 r1, uint256 r2) = triple();
+    require(!cmp || (r0 == e0 && r1 == e1 && r2 == e2));
+  }
+  function readX(uint256 e, bool cmp) public view {
+    uint256 r0 = x;
+    require(!cmp || (r0 == e));
+  }
+  function callFails(uint256 a, uint256 e, bool cmp) public {
+    uint256 r0 = fails(a);
+    require(!cmp || (r0 == e));
+  }
+  function callNested(uint256 e, bool cmp) public {
+    uint256 r0 = nested();
+    require(!cmp || (r0 == e));
+  }
+}`;
+
+// S2: a conditional write into chunked bytes fields: inactive pins and the chunk loop's exit iteration.
+const CONDITIONAL_CHUNKED = `pragma solidcash ^0.13.0;
+contract C() {
+  bytes a;
+  bytes b;
+  function set(bool f, bytes v) { if (f) { this.a = v; } else { this.b = v; } }
+}`;
+
+// S3: a mapping value over 60 bytes plus an event: value chunks, identity-count pins, events.
+const LONG_VALUE_EVENT = `pragma solidcash ^0.13.0;
+contract C() {
+  event Stored(int indexed k);
+  mapping(int => bytes) m;
+  function put(int k, bytes v) { this.m[k] = v; emit Stored(k); }
+}`;
+
+// S4: a constructor keccak, learned at deploy from the side-car's OP_INPUTBYTECODE read.
+const CONSTRUCTOR_KECCAK = `pragma solidcash >=0.8.0;
+  contract C() {
+    bytes32 h;
+    address owner;
+    constructor(bytes x) { owner = msg.sender; this.h = keccak256(x); }
+    function get() public view returns (bytes32) { return this.h; }
+  }`;
+
+type Instruction = { opcode: number; data?: Uint8Array };
+const pushKey = (instruction?: Instruction): string =>
+  `${instruction?.opcode}:${binToHex(instruction?.data ?? new Uint8Array())}`;
+
+/** An OP_DEFINE'd body ends with OP_OUTPUTTOKENCOMMITMENT and OP_EQUALVERIFY follows its OP_INVOKE. */
+const hasCommitmentClosingHelper = (bytecodeHex: string): boolean => {
+  const top = decodeAuthenticationInstructions(hexToBin(bytecodeHex)) as Instruction[];
+  const defined = top.flatMap((instruction, index) => (instruction.opcode === OpcodesBCH.OP_DEFINE
+    ? [{ id: pushKey(top[index - 1]), body: decodeAuthenticationInstructions(top[index - 2]?.data ?? new Uint8Array()) as
+      Instruction[] }]
+    : []));
+  const closing = new Set(defined.filter(({ body }) => body.at(-1)?.opcode === OpcodesBCH.OP_OUTPUTTOKENCOMMITMENT)
+    .map(({ id }) => id));
+  return [top, ...defined.map(({ body }) => body)].some((body) => body.some((instruction, index) =>
+    instruction.opcode === OpcodesBCH.OP_INVOKE && closing.has(pushKey(body[index - 1]))
+    && body[index + 1]?.opcode === OpcodesBCH.OP_EQUALVERIFY));
+};
+
+// S5: runtime-loop transfers, whose probes force the faithful recorder (sc-derive-full-phase2-iteration-probe.ts).
+const RUNTIME_LOOP_TRANSFER = `
+contract C {
+    bytes32 acc;
+    function run(bytes32 seed, bytes20[] recipients, int amount) public {
+        this.acc = seed;
+        for (int i = 0; i < recipients.length; i++) {
+            this.transfer(new LockingBytecodeP2PKH(recipients[i]), amount);
+        }
+    }
+}`;
+
+const artifacts = {
+  S1: compileString(OUTLINED, { evmCompat: true, forceStateful: true }),
+  S2: compileString(CONDITIONAL_CHUNKED, { forceStateful: true, chunkedArrays: true }),
+  S3: compileString(LONG_VALUE_EVENT, { forceStateful: true }),
+  S4: compileString(CONSTRUCTOR_KECCAK, { forceStateful: true }),
+  S5: compileString(RUNTIME_LOOP_TRANSFER, { forceStateful: true, suppressWarnings: true }),
+};
+
+/** Each shape's deploy and calls. */
+const FLOWS: Record<Shape, (signer: Signer) => Promise<void>> = {
+  S1: async (signer) => {
+    const sc = await getContractFactory(artifacts.S1, signer).deploy() as unknown as Handle;
+    await sc.callTriple!(16n, 32n, 64n, true).send();
+    await sc.readX!(1n, true).send();
+  },
+  S2: async (signer) => {
+    const sc = await getContractFactory(artifacts.S2, signer).deploy() as unknown as Handle;
+    await sc.set!(true, new Uint8Array(40).fill(1)).send();
+    await sc.set!(false, new Uint8Array(40).fill(2)).send();
+  },
+  S3: async (signer) => {
+    const sc = await getContractFactory(artifacts.S3, signer).deploy() as unknown as Handle;
+    await sc.put!(1n, new Uint8Array(80).fill(3)).send();
+    await sc.put!(2n, new Uint8Array(90).fill(4)).send();
+  },
+  S4: async (signer) => {
+    await getContractFactory(artifacts.S4, signer).deploy(new Uint8Array([1, 2, 3]));
+  },
+  S5: async (signer) => {
+    const sc = await getContractFactory(artifacts.S5, signer).deploy({ initialBalance: 50_000n }) as unknown as Handle;
+    const seed = new Uint8Array(32).fill(0x56);
+    // The recipients and amounts each call pays, as `lock:satoshis`.
+    const paid = (result: unknown): string[] => (result as TransactionDetails).outputs
+      .map((output) => `${binToHex(output.lockingBytecode)}:${output.valueSatoshis}`);
+    const p2pkh = (byte: number): string => binToHex(Uint8Array.from([0x76, 0xa9, 0x14, ...Array(20).fill(byte), 0x88,
+      0xac]));
+    const first = await sc.run!(seed, [new Uint8Array(20).fill(0x33), new Uint8Array(20).fill(0x44)], 1000n).send();
+    expect(paid(first)).toEqual(expect.arrayContaining([`${p2pkh(0x33)}:1000`, `${p2pkh(0x44)}:1000`]));
+    // Above the 546-satoshi dust threshold a live network enforces (the relaxed mock does not).
+    const second = await sc.run!(seed, [new Uint8Array(20).fill(0x55)], 700n).send();
+    expect(paid(second)).toEqual(expect.arrayContaining([`${p2pkh(0x55)}:700`]));
+  },
+};
+
+const SIGNER_KEY = new Uint8Array(32).fill(0x5a);
+const FUNDING_COINS = 8;
+
+interface FlowRun {
+  readonly provider: NetworkProvider;
+  readonly raws: string[];
+  readonly samples: Array<ProbeTraceParitySample & { readonly shape: Shape | 'funding' }>;
+  readonly draws: number;
+}
+
+async function runFlows(env: Record<string, string>, shapes: readonly Shape[]): Promise<FlowRun> {
+  for (const [key, value] of Object.entries(env)) vi.stubEnv(key, value);
+  runMockNetworkProviderResetHooks();
+  const random = seedRandom('live-limit-probe-parity');
+  let shape: Shape | 'funding' = 'funding';
+  const samples: FlowRun['samples'] = [];
+  setProbeTraceParitySink((sample) => samples.push({ ...sample, shape }));
+  try {
+    const { inner, provider } = liveLikeProvider();
+    const raws: string[] = [];
+    const send = inner.sendRawTransaction.bind(inner);
+    // Prepared sends reach this through `this.sendRawTransaction`, and the proxy binds the own property.
+    inner.sendRawTransaction = async (hex: string): Promise<string> => {
+      raws.push(hex);
+      return send(hex);
+    };
+    const signer = new Signer(SIGNER_KEY, provider);
+    await fundFromTransactions(inner, provider, signer, FUNDING_COINS, 2_000_000n);
+
+    for (const next of shapes) {
+      shape = next;
+      await FLOWS[next](signer);
+    }
+    return { provider, raws, samples, draws: random.draws() };
+  } finally {
+    setProbeTraceParitySink(undefined);
+    random.restore();
+    vi.unstubAllEnvs();
+  }
+}
+
+const frameOf = (frame: unknown): unknown => (typeof frame === 'object' && frame !== null
+  ? { ip: (frame as { ip: number }).ip, instructions: (frame as { instructions: unknown[] }).instructions.length }
+  : frame);
+
+const projection = (state: State): Record<string, unknown> => ({
+  ip: state.ip,
+  instructions: state.instructions.length,
+  error: state.error,
+  stack: state.stack.map((item) => binToHex(item)),
+  alternateStack: state.alternateStack.map((item) => binToHex(item)),
+  controlStack: state.controlStack.map(frameOf),
+  functionCount: state.functionCount,
+  metrics: JSON.stringify(state.metrics),
+  operationCount: state.operationCount,
+  lastCodeSeparator: state.lastCodeSeparator,
+  signedMessages: state.signedMessages.length,
+});
+
+/** A comparable form of an extractor result: hex for bytes, entries for maps, strings for bigints. */
+const comparable = (value: unknown): string => JSON.stringify(value, (_key, item: unknown) => {
+  if (item instanceof Uint8Array) return binToHex(item);
+  if (item instanceof Map) return [...item.entries()];
+  if (typeof item === 'bigint') return item.toString();
+  return item;
+});
+
+const outcome = (read: () => unknown): string => {
+  try {
+    return comparable(read());
+  } catch (error) {
+    return `throws: ${String((error as Error).message ?? error)}`;
+  }
+};
+
+const active = (state: State): boolean => !state.controlStack.some((frame) => frame === false);
+
+/**
+ * Everything the derivation extractors read from one trace. `window` feeds the one heuristic that scans the last 32
+ * states without skipping inactive ones: a reduced `debug()` trace keeps inactive observations, which the observer
+ * drops (instruments Change F), so that window is compared over active states.
+ */
+function extracted(trace: State[], program: ProbeTraceParitySample['program'], window: State[] = trace): string[] {
+  const outputs = program.transaction.outputs.length;
+  const inputs = program.transaction.inputs.length;
+  const reads: Array<() => unknown> = [
+    () => extractCommitmentMapFromTrace(trace),
+    () => extractCommitmentMapFromTrace(trace, undefined, true),
+    ...[OpcodesBCH.OP_OUTPUTBYTECODE, OpcodesBCH.OP_OUTPUTVALUE, OpcodesBCH.OP_OUTPUTTOKENAMOUNT].map((opcode) =>
+      (): unknown => extractVerifiedValuesFromTrace(trace, opcode, { min: 0, max: outputs })),
+    () => extractPendingReturnCommitment(window),
+    () => extractFailingValueChunkCommitments(trace),
+    () => scanKeccakPreimageReads(trace, 0, inputs),
+    ...Array.from({ length: outputs }, (_unused, index) => (): unknown =>
+      [extractPendingReturnCommitmentAtOutput(trace, index), extractHashedReturnCommitmentAtOutput(trace, index)]),
+    () => trace.at(-1)?.error,
+  ];
+  return reads.map(outcome);
+}
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+  vi.restoreAllMocks();
+});
+
+describe('derivation instruments on a live-like provider', () => {
+  it('takes the live derivation path', () => {
+    const { provider } = liveLikeProvider();
+    expect(provider.consensusLimits).toBeUndefined();
+    expect(provider.simulator).toBe(false);
+    expect(usesFastVmPaths(provider)).toBe(false);
+    expect(hasCommitmentClosingHelper(artifacts.S1.debug?.bytecode ?? '')).toBe(true);
+  });
+
+  it('settles the same bytes with the sparse observer as with debug(), and matches debug() trace for trace', async () => {
+    const shapes: Shape[] = ['S1', 'S2', 'S3', 'S4', 'S5'];
+    const old = await runFlows({ SC_FORCE_FULL_PROBE_TRACE: '1', SOLIDCASH_FAITHFUL_DEPLOY_PROBE: '1' }, shapes);
+    const logged = vi.spyOn(console, 'error').mockImplementation(() => {});
+    const current = await runFlows({ SOLIDC_DEBUG_TRACE_PARITY: '1' }, shapes);
+
+    // Determinism first: the funding transactions draw nothing from either instrument.
+    expect(current.raws.slice(0, FUNDING_COINS)).toEqual(old.raws.slice(0, FUNDING_COINS));
+    expect(current.draws).toBe(old.draws);
+    expect(current.raws).toEqual(old.raws);
+
+    const parity = logged.mock.calls.filter(([tag]) => tag === 'probe-trace-parity')
+      .map(([, record]) => record as { equal: unknown });
+    expect(parity.filter((record) => record.equal !== true)).toEqual([]);
+    expect(current.samples.some((sample) => sample.mode === 'sparse' && sample.shape === 'S1')).toBe(true);
+
+    // Collected, so one run reports every disagreement.
+    const mismatches: unknown[] = [];
+    for (const [index, sample] of current.samples.entries()) {
+      const reference = sample.reference as State[];
+      if (sample.mode === 'sparse') {
+        const reduced = reduceProbeTrace(reference) as State[];
+        const ours = extracted(sample.candidate as State[], sample.program);
+        const theirs = extracted(reduced, sample.program, reduced.filter(active));
+        if (comparable(ours) !== comparable(theirs)) mismatches.push({ index, shape: sample.shape, ours, theirs });
+      } else if (comparable((sample.candidate as State[]).map(projection)) !== comparable(reference.map(projection))) {
+        mismatches.push({ index, shape: sample.shape, recorder: 'differs from debug()' });
+      }
+      const rerun = (evaluateFaithfulProbeTrace(current.provider, sample.program) as State[]).map(projection);
+      if (comparable(rerun) !== comparable(reference.map(projection))) {
+        mismatches.push({ index, shape: sample.shape, rerun: 'recorder differs from debug()' });
+      }
+    }
+    expect(mismatches).toEqual([]);
+  }, 600_000);
+});
