+## Change D - `evaluateProbeTrace` modes
+
+**File** `stateful/faithful-probe-trace.ts:956-1043`.
+
+**Current.** `preferFullDebug = maxIn <= 10_000 || SC_FORCE || ROUTE_CONCISE || ROUTE_FULL_OPS` (`:978`). At standard
+limits every probe runs `cachedDebugVm().debug()` then `reduceProbeTrace` (`:1005-1027`), forced or not. The recorder
+runs only when forced above 10k (`:986`, `:994`); parity only there (`:987`). The sparse observer (`:1038-1042`)
+only above 10k.
+
+**New code shape.**
+
+```ts
+/**
+ * Evaluate one derivation probe. Every network uses the sparse observer, which keeps only what the extractors
+ * read; `forceFullDebug` selects the faithful recorder, reduced at ordinary capacity. The full-debug overrides
+ * keep libauth's `debug()` reachable for diagnosing either instrument.
+ */
+export function evaluateProbeTrace(
+  provider: NetworkProvider,
+  program: ProbeProgram,
+  forceFullDebug = false,
+): AuthenticationProgramStateCommon[] {
+  const maxIn = provider.consensusLimits?.maximumInputBytes ?? 10_000;
+  const debugEnv = ...;                                   // unchanged, plus SOLIDC_DEBUG_PROBE_SHAPE block
+  const routeDump = debugEnv?.SOLIDC_DEBUG_ROUTE_CONCISE === '1' || debugEnv?.SOLIDC_DEBUG_ROUTE_FULL_OPS === '1';
+  const timing = debugEnv?.SOLIDC_DEBUG_PROBE_TRACE_TIMING === '1';
+  const parity = debugEnv?.SOLIDC_DEBUG_TRACE_PARITY === '1';
+  const startedAt = timing ? Date.now() : 0;
+  if (debugEnv?.SC_FORCE_FULL_PROBE_TRACE === '1' || routeDump) {
+    try {
+      const full = cachedDebugVm(provider).debug(program) as AuthenticationProgramStateCommon[];
+      if (timing) console.error('probe-trace-debug', { /* as today: ms, states, forced, maxIn, inputs, outputs */ });
+      dumpProbeTerminal(debugEnv, full.at(-1));
+      dumpProbeOperands(debugEnv, full.at(-2));
+      // Keep the existing "Live-network pairing fix" comment here.
+      return maxIn <= 10_000 && !routeDump ? reduceProbeTrace(full) : full;
+    } catch (err) {
+      // V8 arg-limit / OOM on an oversized script: fall through to the observer.
+      if (maxIn <= 10_000) throw err;
+    }
+  } else if (forceFullDebug) {
+    const faithful = evaluateFaithfulProbeTrace(provider, program);
+    if (timing) console.error('probe-trace-faithful', { /* as today */ });
+    if (parity) logRecorderParity(provider, program, faithful);
+    dumpProbeTerminal(debugEnv, faithful.at(-1));
+    dumpProbeOperands(debugEnv, faithful.at(-2));
+    return maxIn <= 10_000 ? reduceProbeTrace(faithful) : faithful;
+  }
+  const cached = cachedProbeVm(provider);
+  cached.collector.reset();
+  const finalState = cached.vm.evaluate(program) as AuthenticationProgramStateCommon;
+  dumpProbeTerminal(debugEnv, finalState);
+  const sparse = cached.collector.finish(finalState);
+  if (timing) console.error('probe-trace-sparse', {
+    ms: Date.now() - startedAt, observations: cached.collector.stats().observations, maxIn,
+    inputs: program.transaction.inputs.length, outputs: program.transaction.outputs.length,
+  });
+  if (debugEnv?.SOLIDC_DEBUG_PROBE_OPERANDS === '1' && finalState.error !== undefined) {
+    // The observer keeps no state before the failing operation; the recorder reproduces it.
+    dumpProbeOperands(debugEnv, evaluateFaithfulProbeTrace(provider, program).at(-2));
+  }
+  if (parity) logSparseParity(provider, program, sparse);
+  return sparse;
+}
+```
+
+Export `type ProbeProgram` (`:72`) and use it in every signature in this file.
