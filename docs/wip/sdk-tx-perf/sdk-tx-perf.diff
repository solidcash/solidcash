+/**
+ * A MockNetworkProvider the SDK sees as a live network: no published limits, no simulator ledger. Coins must come
+ * from transactions it serves (own-coin.ts proves them by txid), which `fundFromTransactions` provides.
+ */
+export function liveLikeProvider(): { inner: MockNetworkProvider; provider: NetworkProvider } {
+  const inner = new MockNetworkProvider({ consensusLimits: STANDARD_LIMITS });
+  const provider = new Proxy(inner, {
+    get(target, key): unknown {
+      if (key === 'simulator') return false;
+      if (key === 'consensusLimits' || key === 'getLedgerOutput') return undefined;
+      const value: unknown = Reflect.get(target, key, target);
+      return typeof value === 'function' ? value.bind(target) : value;
+    },
+  }) as unknown as NetworkProvider;
+  return { inner, provider };
+}
