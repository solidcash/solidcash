@@ -0,0 +1,89 @@
+/**
+ * Benchmarks for the SDK transaction-building design in `docs/wip/sdk-tx-perf/DESIGN.md`.
+ *
+ * Skipped unless `SDK_PERF=1`. Each shape is a contract whose loop writes a mapping value the body computes,
+ * so every entry requires a committed value; a values-as-arguments variant converges without probing. The
+ * probe-count assertions are the reliable signal; the timings vary enough that one run proves nothing.
+ *
+ * Run:
+ *   SDK_PERF=1 SOLIDC_DEBUG_BUILDER_TIMING=1 npx vitest run \
+ *     --config vitest.e2e.config.ts test/e2e/SdkTxPerfProbe.test.ts --disableConsoleIntercept
+ */
+import { describe, expect, it } from 'vitest';
+import { compileString } from 'solidc';
+import { Contract, SignatureTemplate } from '../../src/index.js';
+import { StatefulContract } from '../../src/stateful/index.js';
+import { alicePriv, alicePub } from '../fixture/vars.js';
+import { createTestProvider, setupStatefulUtxos } from '../test-util.js';
+
+const ENTRY = `contract C() {
+  mapping(int => int) bal;
+  function setAll(int[] ks, int[] vs, pubkey pk, sig sg) {
+    require(checkSig(sg, pk));
+    for (uint i = 0; i < ks.length; i = i + 1) { bal[ks[i]] = int(i) + 7; }
+  }
+}`;
+
+const ENTRY_EVENT = `contract C() {
+  mapping(int => int) bal;
+  event Tick(int indexed i);
+  function setAll(int[] ks, int[] vs, pubkey pk, sig sg) {
+    require(checkSig(sg, pk));
+    for (uint i = 0; i < ks.length; i = i + 1) {
+      bal[ks[i]] = int(i) + 7;
+      emit Tick(int(i));
+    }
+  }
+}`;
+
+async function call(
+  artifact: ReturnType<typeof compileString>,
+  n: number,
+  expectedIterations: number,
+): Promise<{ ms: number; iterations: number; txid: string }> {
+  const provider = createTestProvider();
+  const sig = new SignatureTemplate(alicePriv);
+  const contract = new Contract(artifact, [], { provider });
+  const { categoryId } = await setupStatefulUtxos(
+    provider, contract, artifact.stateLayout!, {}, { saltContract: true },
+  );
+  const sc = StatefulContract.withCategory(contract, categoryId);
+  const keys = Array.from({ length: n }, (_, index) => BigInt(index + 1));
+  const values = Array.from({ length: n }, (_, index) => BigInt(100 + index));
+  const startedAt = performance.now();
+  const sent = await sc.setAll(keys, values, alicePub, sig).send();
+  const ms = performance.now() - startedAt;
+  const iterations = sc.lastDerivationIterations;
+  expect(iterations).toBe(expectedIterations);
+  return { ms, iterations, txid: sent.txid };
+}
+
+describe.skipIf(process.env.SDK_PERF !== '1')('SDK transaction-building probe', () => {
+  it('scales loop-entry and event derivation with N', async () => {
+    const shapes = [
+      { label: 'entry', artifact: compileString(ENTRY), extraProbes: 1 },
+      { label: 'event', artifact: compileString(ENTRY_EVENT), extraProbes: 2 },
+    ] as const;
+    for (const n of [4, 8, 16]) {
+      for (const shape of shapes) await call(shape.artifact, n, n + shape.extraProbes);
+      const times: Record<string, number[]> = { entry: [], event: [] };
+      for (let rep = 0; rep < 5; rep += 1) {
+        // Alternate the order so one shape does not always pay the first-after-warm-up cost.
+        const order = rep % 2 === 0 ? shapes : [...shapes].reverse();
+        for (const shape of order) {
+          const { ms, iterations, txid } = await call(shape.artifact, n, n + shape.extraProbes);
+          times[shape.label].push(ms);
+          console.log(
+            `PERF n=${n} ${shape.label} rep=${rep} ms=${ms.toFixed(1)} `
+            + `iterations=${iterations} txid=${txid}`,
+          );
+        }
+      }
+      for (const shape of shapes) {
+        console.log(
+          `PERF-MIN n=${n} ${shape.label} min=${Math.min(...times[shape.label]).toFixed(1)}`,
+        );
+      }
+    }
+  }, 1_800_000);
+});
