pragma solidcash ^0.13.0;

// Simplified stateful port of MarketplaceV1 for the admin/registry/job describe blocks. The escrow-wiring
// addresses (unicrow/dispute/arbitrator/treasury) are accepted by initialize but not stored - keeping the state
// NFT commitment under the 128-byte limit - since the admin tests only exercise pause/version/data-address.
contract MarketplaceV1() {
  event OwnershipTransferred(address indexed previousOwner, address indexed newOwner);
  event Paused(address account);
  event Unpaused(address account);
  event VersionChanged(int version);

  address owner;
  bool paused;
  int version;
  bool initialized;
  address marketplaceDataAddress;

  function initialize(address unicrow, address dispute, address arb, address treasury, int fee) delegate {
    require(!this.initialized, "InvalidInitialization");
    require(fee >= 0);
    this.owner = msg.sender;
    this.version = 1;
    this.initialized = true;
  }

  function setMarketplaceDataAddress(address dataAddr) delegate {
    require(msg.sender == this.owner);
    this.marketplaceDataAddress = dataAddr;
  }

  function pause() delegate {
    require(msg.sender == this.owner);
    this.paused = true;
    emit Paused(msg.sender);
  }

  function unpause() delegate {
    require(msg.sender == this.owner);
    this.paused = false;
    emit Unpaused(msg.sender);
  }

  function setVersion(int v) delegate {
    require(msg.sender == this.owner);
    this.version = v;
    emit VersionChanged(v);
  }

  function transferOwnership(address newOwner) delegate {
    require(msg.sender == this.owner);
    address previousOwner = this.owner;
    this.owner = newOwner;
    emit OwnershipTransferred(previousOwner, newOwner);
  }
}
