{
  "name": "root",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=22",
    "yarn": ">=1.22.19 <2"
  },
  "workspaces": [
    "packages/*",
    "examples",
    "examples/testing-suite"
  ],
  "resolutions": {
    "ws": "8.21.0",
    "@bitauth/libauth": "git+https://github.com/mainnet-pat/libauth.git#1cf4b432864b3a4ed9f33d1992355d7286f3dab8"
  },
  "devDependencies": {
    "@noble/hashes": "^1.4.0",
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/contracts-upgradeable": "5.0.2",
    "@prb/math": "4.1.0",
    "@sablier/lockup": "2.0.1",
    "@types/node": "^22.17.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cspell": "^9.2.0",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.31.0",
    "lerna": "^3.22.1",
    "semver": "^7.7.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^6.4.1",
    "@vitest/coverage-v8": "^5.0.4"
  },
  "scripts": {
    "test": "lerna run test --ignore solidcash-examples && yarn workspace testing-suite test",
    "test:fast": "lerna run test:fast --ignore solidcash-examples --ignore testing-suite",
    "test:e2e": "yarn workspace @solidcash/solidcash test:e2e",
    "test:all": "yarn test && yarn test:e2e",
    "test:regtest": "yarn workspace @solidcash/solidcash test:regtest",
    "test:package-smoke": "node scripts/release-package-smoke.mjs",
    "test:docs-snippets": "tsx scripts/release-docs-snippets.ts",
    "test:corpus-baseline": "node scripts/release-corpus-baseline.mjs",
    "test:application-conformance": "node scripts/release-application-conformance.mjs",
    "test:application-regtest": "node scripts/release-application-regtest.mjs",
    "test:generated-project-smoke": "node scripts/release-generated-project-smoke.mjs",
    "test:security-conformance": "node scripts/release-security-conformance.mjs",
    "test:kernel-beta": "node scripts/kernel-beta-gate.mjs",
    "test:kernel-beta:local": "node scripts/kernel-beta-gate.mjs --tests-only --allow-dirty",
    "check:source-tree": "node scripts/check-source-tree.mjs",
    "check:doc-citations": "node scripts/check-doc-citations.mjs",
    "lint": "lerna run lint --ignore solidcash-examples && yarn workspace testing-suite lint",
    "examples": "tsx examples/p2pkh.ts && tsx examples/transfer_with_timeout.ts && tsx examples/hodl_vault.ts",
    "postinstall": "yarn build",
    "spellcheck": "git ls-files -z | xargs -0 cspell lint --no-progress --no-gitignore",
    "update-version": "tsx update-version.ts",
    "publish-all": "lerna publish from-package",
    "solidcash": "node packages/testing/dist/cli.js",
    "build": "tsc -b tsconfig.packages.json && yarn workspace testing-suite compile",
    "build:watch": "tsc -b tsconfig.packages.json --watch --preserveWatchOutput --assumeChangesOnlyAffectDirectDependencies",
    "test:compiler:watch": "yarn workspace @solidcash/solidc test:watch",
    "test:compiler:changed": "yarn workspace @solidcash/solidc test:changed",
    "test:sdk:watch": "yarn workspace @solidcash/solidcash test:watch",
    "test:sdk:changed": "yarn workspace @solidcash/solidcash test:changed",
    "test:e2e:watch": "yarn workspace @solidcash/solidcash test:e2e:watch",
    "test:e2e:changed": "yarn workspace @solidcash/solidcash test:e2e:changed"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "viem": "^2.55.4"
  }
}
