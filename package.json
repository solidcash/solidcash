{
  "name": "root",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22 <23",
    "yarn": ">=1.22.22 <2"
  },
  "workspaces": [
    "packages/*",
    "examples",
    "examples/testing-suite"
  ],
  "devDependencies": {
    "@noble/hashes": "^1.4.0",
    "@openzeppelin/contracts": "5.0.2",
    "@types/node": "^22.17.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "cspell": "^9.2.0",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.31.0",
    "lerna": "^3.22.1",
    "semver": "^7.7.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "test": "lerna run test --ignore solidcash-examples && yarn workspace testing-suite test",
    "test:fast": "lerna run test:fast --ignore solidcash-examples --ignore testing-suite",
    "test:e2e": "yarn workspace solidcash test:e2e",
    "test:all": "yarn test && yarn test:e2e",
    "test:regtest": "yarn workspace solidcash test:regtest",
    "test:package-smoke": "node scripts/release-package-smoke.mjs",
    "test:docs-snippets": "tsx scripts/release-docs-snippets.ts",
    "test:application-conformance": "node scripts/release-application-conformance.mjs",
    "test:application-regtest": "node scripts/release-application-regtest.mjs",
    "test:generated-project-smoke": "node scripts/release-generated-project-smoke.mjs",
    "test:security-conformance": "node scripts/release-security-conformance.mjs",
    "lint": "lerna run lint --ignore solidcash-examples && yarn workspace testing-suite lint",
    "examples": "tsx examples/p2pkh.ts && tsx examples/transfer_with_timeout.ts && tsx examples/hodl_vault.ts",
    "postinstall": "yarn build",
    "spellcheck": "cspell lint '**' --no-progress --must-find-files",
    "update-version": "tsx update-version.ts",
    "publish-all": "lerna publish from-package",
    "build": "tsc -b tsconfig.packages.json && yarn workspace testing-suite compile",
    "build:watch": "tsc -b tsconfig.packages.json --watch --preserveWatchOutput --assumeChangesOnlyAffectDirectDependencies",
    "test:compiler:watch": "yarn workspace solidc test:watch",
    "test:compiler:changed": "yarn workspace solidc test:changed",
    "test:sdk:watch": "yarn workspace solidcash test:watch",
    "test:sdk:changed": "yarn workspace solidcash test:changed",
    "test:e2e:watch": "yarn workspace solidcash test:e2e:watch",
    "test:e2e:changed": "yarn workspace solidcash test:e2e:changed"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "viem": "^2.55.4"
  }
}
