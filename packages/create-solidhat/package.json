{
  "name": "@solidcash/create-solidhat",
  "version": "0.14.0-beta.1",
  "description": "Create a new SolidHat project",
  "keywords": ["solidcash", "bitcoin cash", "project initializer"],
  "homepage": "https://solidcash.org",
  "bugs": { "url": "https://github.com/solidcash/solidcash/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/solidcash/solidcash.git" },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22" },
  "author": "mainnet-pat",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "create-solidhat": "dist/cli.js" },
  "scripts": {
    "build": "yarn compile",
    "clean": "rm -rf ./dist *.tsbuildinfo",
    "compile": "tsc -p tsconfig.build.json",
    "rebuild": "yarn clean && yarn compile",
    "lint": "eslint . --ext .ts --ignore-path ../../.eslintignore",
    "prepare": "yarn rebuild",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "@solidcash/solidhat": "^0.14.0-beta.1" },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "eslint": "^8.54.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  }
}
