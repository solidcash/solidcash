{
  "name": "solidc",
  "version": "0.13.1",
  "description": "SolidCash compiler - compile smart contracts to Bitcoin Cash Script or artifacts",
  "keywords": [
    "bitcoin",
    "bitcoin cash",
    "solidcash",
    "compiler",
    "smart contracts",
    "cashtokens"
  ],
  "homepage": "https://solidcash.org",
  "bugs": {
    "url": "https://github.com/CashScript/cashscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CashScript/cashscript.git"
  },
  "license": "MIT",
  "author": "Rosco Kalis <roscokalis@gmail.com>",
  "contributors": [
    "Mathieu Geukens <mr-zwets@protonmail.com>",
    "Gabriel Cardona <gabriel@bitcoin.com>"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "solidc": "dist/solidc-cli.js"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "antlr": "antlr -Dlanguage=TypeScript -visitor -no-listener src/grammar/SolidCash.g4",
    "build": "yarn compile",
    "clean": "rm -rf ./dist *.tsbuildinfo",
    "compile": "tsc -p tsconfig.build.json",
    "rebuild": "yarn clean && yarn compile",
    "lint": "eslint . --ext .ts --ignore-path ../../.eslintignore",
    "prepare": "yarn rebuild",
    "prepublishOnly": "yarn test && yarn lint",
    "test": "vitest run",
    "test:hardhat-console": "vitest run --config vitest.hardhat-console.config.ts",
    "test:fast": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.1.0-next.8",
    "@noble/hashes": "^2.0.0",
    "@solidcash/utils": "^0.13.1",
    "antlr4": "^4.13.2",
    "commander": "^14.0.0",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/semver": "^7.7.0",
    "@vitest/coverage-v8": "^4.0.15",
    "cpy-cli": "^5.0.0",
    "eslint": "^8.54.0",
    "eslint-plugin-import": "^2.31.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.0.15"
  },
  "gitHead": "bf02a4b641d5d03c035d052247a545109c17b708"
}
