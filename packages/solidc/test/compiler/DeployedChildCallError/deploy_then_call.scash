// Calling a method on a freshly-deployed child in the same transaction is refused. Since B10 the child is
// created through its deployer, and a call on it cannot be bound at its creation; call it in a later
// transaction. (The old fold path refused the same shape as DeployThenCallError.)
contract Child(bytes20 owner) {
    int counter;
    function configure(int target) {
        while (target > 0) {
            this.counter = target;
            target = 0;
        }
        require(true);
    }
}

contract Factory(pubkey deployer) {
    int deployed;
    function make(sig s, bytes20 owner, int target) {
        require(checkSig(s, deployer));
        Child c = new Child(owner);
        c.configure(target);
        this.deployed = this.deployed + 1;
    }
}
