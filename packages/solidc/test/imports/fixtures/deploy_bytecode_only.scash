import "./deploy_target.scash";

// Non-stateful contract that computes a deployed contract's locking bytecode
contract DeployBytecodeOnly() {
    function run(pubkey pk, sig s, bytes20 targetPkh) {
        require(checkSig(s, pk));
        bytes deployedLbc = new DeployTarget(targetPkh);
        require(tx.outputs[0].lockingBytecode == deployedLbc);
    }
}
