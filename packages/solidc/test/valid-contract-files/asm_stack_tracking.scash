contract AsmStackTracking() {
    function test(int a, int b) {
        // Net +1 assembly block: leaves one extra item on the stack. The compiler
        // must track this so the references to a and b below resolve to the correct
        // (shifted) stack positions.
        assembly {
            OP_TXVERSION
            OP_DROP
            OP_INPUTINDEX
        }
        require(a == 11);
        require(b == 22);
    }
}
