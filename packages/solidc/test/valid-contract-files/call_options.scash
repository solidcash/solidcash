pragma solidcash >=0.8.0;

interface ICounter {
    public int counter;
    function increment();
}

contract CallOptionTest(address target) {
    int state;

    // External call with {value: X}
    function callWithValue(int amount) {
        ICounter(target).increment{value: amount}();
        this.state = this.state + 1;
    }

    // Low-level call with {value: X}
    function lowLevelCallWithValue(int amount) {
        ICounter(target).increment.call{value: amount}();
        this.state = this.state + 1;
    }

    // Gas-only option (no-op)
    function callWithGas() {
        ICounter(target).increment{gas: 800}();
        this.state = this.state + 1;
    }

    // Both value and gas
    function callWithBoth(int amount) {
        ICounter(target).increment{value: amount, gas: 800}();
        this.state = this.state + 1;
    }
}
