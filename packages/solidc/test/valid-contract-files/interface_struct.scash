interface IData {
    struct Score { int value; string label; }
    public int count;
    public mapping(int => Score) scores;
}

contract DataReader(address data) {
    int total;

    function readScore(int id, pubkey pk, sig s) {
        require(checkSig(s, pk));
        Score score = IData(data).scores[id];
        this.total = this.total + score.value;
    }

    function authorize(pubkey pk, sig s) unsafe { require(checkSig(s, pk)); }
}
