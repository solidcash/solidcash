library L {
    // A library function may call a sibling library function by its unqualified name.
    function a(int x) internal returns (int) {
        return b(x) + 1;
    }
    function b(int x) internal returns (int) {
        return x * 2;
    }
}

contract LibrarySiblingCall() {
    using L for int;
    function f(int x) {
        require(x.a() == x * 2 + 1);
    }
}
