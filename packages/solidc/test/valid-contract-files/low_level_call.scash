pragma solidcash >=0.8.0;

interface ICounter {
    public int counter;
    function increment();
}

contract DynamicCaller(address target) {
    int state;

    function dynamicCall() {
        ICounter(target).increment.call();
        this.state = this.state + 1;
    }

    function readOnlyCall() {
        ICounter(target).increment.staticcall();
        this.state = this.state + 1;
    }
}
