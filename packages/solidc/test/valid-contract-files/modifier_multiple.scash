contract MultiGuarded(bytes20 pkh) {
    modifier timelocked {
        require(this.age >= 100);
        _;
    }

    modifier timeBound {
        require(tx.time >= 1000);
        _;
    }

    function spend(pubkey pk, sig s) timelocked timeBound {
        require(hash160(pk) == pkh);
        require(checkSig(s, pk));
    }
}
