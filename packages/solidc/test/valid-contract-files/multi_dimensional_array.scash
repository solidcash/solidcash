pragma solidcash ^0.14.0;

contract MultiDimensionalArray() {
    // 2D array operations: local variable, access, assign, literal
    function test2DLiteral(int row, int col) {
        // 2D array literal: 3x3 identity-like matrix
        int[3][] matrix = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];

        // Access: matrix[row] returns int[3], then [col] returns int
        int val = matrix[row][col];
        require(val >= 0);
    }

    function test2DAssign(int row, int col, int newVal) {
        int[3][] matrix = [[1, 2, 3], [4, 5, 6]];

        // Chained access
        int old = matrix[row][col];
        require(old != newVal);

        // Single-dimension operations still work on the outer array
        int[] innerRow = matrix[row];
        require(innerRow.length == 3);
    }

    function test2DPushPop() {
        // Dynamic outer array of fixed inner arrays
        int[3][] rows = [[10, 20, 30]];
        rows.push([40, 50, 60]);
        require(rows.length == 2);

        // Access pushed element
        int val = rows[1][0];
        require(val == 40);

        rows.pop();
        require(rows.length == 1);
    }
}
