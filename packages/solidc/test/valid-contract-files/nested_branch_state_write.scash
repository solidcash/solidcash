contract NestedBranch() {
    int counter;
    bytes4 label;

    function nestedUpdate(bool outer, bool inner, bytes4 newLabel) {
        if (outer) {
            if (inner) {
                this.counter = this.counter + 2;
                this.label = newLabel;
            } else {
                this.counter = this.counter + 1;
                this.label = 0x00000000;
            }
        } else {
            this.counter = this.counter;
            this.label = this.label;
        }
    }
}
