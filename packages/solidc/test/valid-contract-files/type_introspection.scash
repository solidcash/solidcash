interface IToken {
    public int supply;
    function mint(int amount);
    function burn(int amount);
}

contract TypeIntrospection() {
    enum Color { Red, Green, Blue }

    function checkIntBounds(bigint x, pubkey pk, sig s) {
        require(checkSig(s, pk));
        require(x >= type(int8).min);
        require(x <= type(int8).max);
    }

    function checkUintBounds(bigint x, pubkey pk, sig s) {
        require(checkSig(s, pk));
        require(x >= type(uint8).min);
        require(x <= type(uint256).max);
    }

    function checkEnumBounds(bigint x, pubkey pk, sig s) {
        require(checkSig(s, pk));
        require(x >= type(Color).min);
        require(x <= type(Color).max);
    }

    function checkInterfaceId(bytes4 id, pubkey pk, sig s) {
        require(checkSig(s, pk));
        require(id == type(IToken).interfaceId);
    }

    function checkContractName(string name, pubkey pk, sig s) {
        require(checkSig(s, pk));
        require(name == type(TypeIntrospection).name);
    }
}
