contract UpgradeCounter() {
    event Incremented(int counter);

    function increment(int counter) {
        emit Incremented(counter + 1);
    }

    function migrate(pubkey admin, sig s) upgrade {
        require(checkSig(s, admin));
    }

    function authorize(pubkey pk, sig s) unsafe {
        require(checkSig(s, pk));
    }
}
