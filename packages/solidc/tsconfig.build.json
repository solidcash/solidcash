{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [
      "node",
      "vitest/globals"
    ],
    // The rest of the monorepo builds with nodenext. This package keeps classic resolution because the
    // ANTLR-generated parser under src/grammar imports `antlr4` in a way that only type-checks under
    // `node`; switching it to nodenext loses the inherited members of the generated context classes.
    "module": "esnext",
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*",
  ],
  "references": [{ "path": "../utils/tsconfig.build.json" }]
}
