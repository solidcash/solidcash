pragma solidcash >=0.8.0;

// CashTokens-backed wrap/unwrap extension for ledger tokens.
//
// The sibling ERC20 implementation owns balances and policy. A concrete token
// implements the hooks below, then composes both bases and names the bearer
// token's category from its constructor:
//
//   contract MyToken() is ERC20, BchNative {
//       constructor(bytes32 nativeCategory_) BchNative(nativeCategory_) { }
//   }
//   contract RegulatedToken(address admin) is ERC20, BchNative, BlackList { ... }
//
// BchNative owns only the immediate BCH-native reserve boundary, so it can be
// reused without assuming a particular ERC20 allowance, pause, blacklist, or
// compliance model. Inherit BchNativeQuarantine separately for delayed
// admission, pending state, and block-oracle timing.
//
// The bearer form is a CashTokens category of its own, which the deployment
// creates beside the contract's (`nativeToken.funding`), or an existing one it
// names (`nativeToken.category`, see BchNativeWrapper). It is not the
// contract's own category: a framed composition refuses any fungible amount of
// the contract's own category, and a category of its own keeps the token's BCMR
// identity and supply apart from the contract's state NFTs (docs/bcmr/DESIGN.md,
// section 6).
abstract contract BchNative {
    // The bearer token's category, in the byte order `this.tokens[...]` takes. A deployment reads it back
    // through the artifact, which publishes it as the reserve container's key.
    internal bytes32 immutable _nativeCategory;

    constructor(bytes32 nativeCategory_) {
        this._nativeCategory = nativeCategory_;
    }

    // Integration hooks supplied by the concrete token. Policy hooks return
    // false to refuse the operation; cancellation is separate so a rejected
    // admission can always remain recoverable if the token chooses.
    function _nativeCredit(address account, uint256 amount) internal virtual;
    function _nativeDebit(address account, uint256 amount) internal virtual;
    // Event hooks are no-ops in the minimal extension.
    function _nativeEmitUnwrapped(address _from, int _value) internal virtual { }
    function _nativeEmitWrapped(address _to, int _value) internal virtual { }
    function _nativeCanWrap(address account) internal view virtual returns (bool) { return true; }
    function _nativeCanUnwrap(address account) internal view virtual returns (bool) { return true; }
    // The native amount that crosses the reserve for a ledger amount; a scaling layer overrides it.
    function _nativeAmount(int amount) internal view virtual returns (int) { return amount; }

    // Direct wrap: prove the reserve grew by exactly the native amount, then credit the sibling ledger.
    function wrap(int amount) virtual {
        bytes32 category = this._nativeCategory;
        require(amount > 0);
        address claimant = msg.sender;
        require(_nativeCanWrap(claimant));
        int nativeAmount = _nativeAmount(amount);
        int reserveBefore = this.tokens[category].tokenAmount;
        int reserveAfter = this.outState.tokens[category].tokenAmount;
        require(reserveAfter == reserveBefore + nativeAmount);

        _nativeCredit(claimant, uint256(amount));
        _nativeEmitWrapped(claimant, amount);
    }

    // Unwrap ledger units into bearer CashTokens.
    function unwrap(address to, int amount) virtual {
        bytes32 category = this._nativeCategory;
        address sender = msg.sender;
        require(_nativeCanUnwrap(sender));
        require(amount > 0);
        int nativeAmount = _nativeAmount(amount);
        require(this.tokens[category].tokenAmount >= nativeAmount);

        _nativeDebit(sender, uint256(amount));
        this.tokens[category].transfer(to, nativeAmount);
        _nativeEmitUnwrapped(sender, amount);
    }
}
