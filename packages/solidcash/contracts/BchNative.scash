pragma solidcash >=0.8.0;

// CashTokens-backed wrap/unwrap extension for ledger tokens.
//
// The sibling ERC20 implementation owns balances and policy. A concrete token
// implements the hooks below, then composes both bases:
//
//   contract MyToken(address admin) is ERC20, BchNative { ... }
//   contract RegulatedToken(address admin) is ERC20, BchNative, BlackList { ... }
//
// BchNative owns only the BCH-native reserve and admission state, so it can be
// reused without assuming a particular ERC20 allowance, pause, blacklist, or
// compliance model.
abstract contract BchNative {

    struct Pending {
        int amount;
        int unlockAt;
    }

    // Pinned once after genesis because the contract category is not known to
    // source-level constructor code.
    public bytes32 backingCategory;
    public bool backingSet;
    // Physical reserve observed by the ledger and the portion represented by
    // balances or pending deposits. Consensus requires containerSeen >= backedSupply.
    public int containerSeen;
    public int backedSupply;

    mapping(address => Pending) public pendingDeposits;
    public int quarantineBlocks;
    // Monotonic CLTV-verified chain height used to timestamp admissions.
    public int clock;

    event Withdrawal(address indexed from, int value);
    event Wrapped(address indexed to, int value);
    event DepositQuarantined(address indexed to, int value, int unlockAt);
    event DepositClaimed(address indexed to, int value);
    event DepositCancelled(address indexed to, int value);
    event QuarantineParams(int blocks);

    // Integration hooks supplied by the concrete token. Policy hooks return
    // false to refuse the operation; cancellation is separate so a rejected
    // admission can always remain recoverable if the token chooses.
    function _nativeAdmin() internal view returns (address);
    function _nativeCredit(address account, int amount) internal;
    function _nativeDebit(address account, int amount) internal;
    function _nativeCanWrap(address account) internal view returns (bool);
    function _nativeCanDeposit(address account) internal view returns (bool);
    function _nativeCanUnwrap(address account) internal view returns (bool);
    function _nativeCanClaim(address account) internal view returns (bool);
    function _nativeCanCancel(address account) internal view returns (bool);

    function setBacking(bytes32 category) {
        require(msg.sender == _nativeAdmin());
        require(!this.backingSet);
        this.backingSet = true;
        this.backingCategory = category;
        this.containerSeen = this.tokens[category].tokenAmount;
    }

    // Direct wrap: prove the reserve grew, then credit the sibling ledger.
    function wrap(bytes32 category, int amount) {
        require(this.backingSet);
        require(category == this.backingCategory);
        require(amount > 0);
        address claimant = msg.sender;
        require(_nativeCanWrap(claimant));
        int reserveBefore = this.tokens[category].tokenAmount;
        int reserveAfter = this.outState.tokens[category].tokenAmount;
        require(reserveAfter >= reserveBefore + amount);

        this.containerSeen = this.containerSeen + amount;
        this.backedSupply = this.backedSupply + amount;
        _nativeCredit(claimant, amount);
        emit Wrapped(claimant, amount);
    }

    // Unwrap ledger units into bearer CashTokens.
    function withdraw(bytes32 category, bytes20 to, int amount) {
        require(this.backingSet);
        require(category == this.backingCategory);
        address sender = msg.sender;
        require(_nativeCanUnwrap(sender));
        require(amount > 0);
        require(this.tokens[category].tokenAmount >= amount);

        _nativeDebit(sender, amount);
        this.backedSupply = this.backedSupply - amount;
        this.containerSeen = this.containerSeen - amount;
        this.tokens[category].transfer(new LockingBytecodeP2PKH(to), amount);
        emit Withdrawal(sender, amount);
    }

    // Observe FTs delivered to the token container and quarantine their ledger admission.
    function deposit(bytes32 category, int nowHeight, int amount) {
        require(this.backingSet);
        require(category == this.backingCategory);
        require(amount > 0);
        require(tx.time >= nowHeight);
        require(nowHeight >= this.clock);
        this.clock = nowHeight;

        address claimant = msg.sender;
        require(_nativeCanDeposit(claimant));
        Pending current = this.pendingDeposits[claimant];
        require(current.amount == 0);

        int reserveBefore = this.tokens[category].tokenAmount;
        int reserveAfter = this.outState.tokens[category].tokenAmount;
        require(reserveAfter >= reserveBefore + amount);

        this.containerSeen = this.containerSeen + amount;
        this.backedSupply = this.backedSupply + amount;
        int unlockAt = nowHeight + this.quarantineBlocks;
        this.pendingDeposits[claimant] = Pending({ amount: amount, unlockAt: unlockAt });
        emit DepositQuarantined(claimant, amount, unlockAt);
    }

    function claimDeposit() {
        address claimant = msg.sender;
        require(_nativeCanClaim(claimant));
        Pending pending = this.pendingDeposits[claimant];
        require(pending.amount > 0);
        require(tx.time >= pending.unlockAt);

        delete this.pendingDeposits[claimant];
        _nativeCredit(claimant, pending.amount);
        emit DepositClaimed(claimant, pending.amount);
    }

    function cancelDeposit(bytes32 category, bytes20 to) {
        require(this.backingSet);
        require(category == this.backingCategory);
        address claimant = msg.sender;
        require(_nativeCanCancel(claimant));
        Pending pending = this.pendingDeposits[claimant];
        require(pending.amount > 0);
        require(this.tokens[category].tokenAmount >= pending.amount);

        delete this.pendingDeposits[claimant];
        this.containerSeen = this.containerSeen - pending.amount;
        this.backedSupply = this.backedSupply - pending.amount;
        this.tokens[category].transfer(new LockingBytecodeP2PKH(to), pending.amount);
        emit DepositCancelled(claimant, pending.amount);
    }

    // Permissionless CLTV-backed clock maintenance.
    function tick(int nowHeight) {
        require(tx.time >= nowHeight);
        require(nowHeight >= this.clock);
        this.clock = nowHeight;
    }

    function setQuarantineBlocks(int blocks) {
        require(msg.sender == _nativeAdmin());
        require(blocks >= 0);
        this.quarantineBlocks = blocks;
        emit QuarantineParams(blocks);
    }
}
