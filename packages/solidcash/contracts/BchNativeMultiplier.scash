pragma solidcash >=0.8.0;

import { BchNative } from "./BchNative.scash";

// Optional scale layer for the BchNative reserve boundary.
//
// CashTokens cap a fungible amount at the signed 64-bit maximum
// (9223372036854775807), while an 18-decimal ERC20 ledger can express far more
// base units. This layer compresses the ledger into the native reserve: one
// native CashToken base unit backs `multiplier` ledger units, and wrap/unwrap
// convert with `native = ledger / multiplier`.
//
//   contract MyToken() is ERC20, BchNative, BchNativeMultiplier(100) { ... }
//   contract MyWrapped() is BchNativeWrapper, BchNativeMultiplier(100) { ... }
//
// The multiplier is an immutable state variable set once at construction from
// the inheritance-list argument, so each deployment fixes its own scale factor.
// It must be positive, and boundary amounts must be an exact multiple of the
// multiplier so the reserve stays exactly backed.
//
// This layer overrides only BchNative's `_nativeAmount` hook, which wrap and
// unwrap apply, and keeps that override final. The optional quarantined
// boundary (BchNativeQuarantine's deposit/claim/cancel) is not scaled here; a
// token composing all three must scale those paths itself.
abstract contract BchNativeMultiplier is BchNative {
    internal int immutable _nativeMultiplier;

    constructor(int multiplier) {
        this._nativeMultiplier = multiplier;
    }

    // Convert a ledger amount to the native CashToken amount moved at the
    // reserve boundary, refusing amounts the multiplier cannot represent exactly.
    function _nativeAmount(int amount) internal view override returns (int) {
        require(amount % this._nativeMultiplier == 0);
        return amount / this._nativeMultiplier;
    }
}
