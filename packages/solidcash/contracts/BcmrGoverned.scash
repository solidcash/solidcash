pragma solidcash >=0.8.0;

// Contract-governed BCMR metadata (docs/bcmr/DESIGN.md, section 9).
//
// Deployed with the `governed` identity policy, a contract's BCMR identity output sits under a guard that
// publishes a registry only beside a MetadataUpdated event this contract emitted for it: the event names the
// registry's SHA-256 and the guard's current outpoint, so each authorization serves once. The guard spends the
// event NFT once it matures, 144 blocks after the emit, which announces every change a day ahead.
//
//   contract MyToken() is ERC20, BchNative, BcmrGoverned {
//       function _bcmrMayUpdate() internal view override returns (bool) { return msg.sender == this.owner; }
//   }
//
// The SDK's `governedAuthorization` gives the two arguments; `applyGovernedMetadata` publishes once it matures.
abstract contract BcmrGoverned {
    event MetadataUpdated(bytes32 registryHash, bytes32 identityTxid);

    // Who may authorize a registry: the concrete contract's own access control.
    function _bcmrMayUpdate() internal view virtual returns (bool);

    function updateMetadata(bytes32 registryHash, bytes32 identityTxid) {
        require(_bcmrMayUpdate());
        emit MetadataUpdated(registryHash, identityTxid);
    }
}
