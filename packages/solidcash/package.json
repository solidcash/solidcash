{
  "name": "solidcash",
  "version": "0.13.1",
  "description": "SolidCash SDK - easily write and interact with Bitcoin Cash contracts",
  "keywords": [
    "bitcoin cash",
    "solidcash",
    "sdk",
    "smart contracts",
    "cashtokens"
  ],
  "homepage": "https://solidcash.org",
  "bugs": {
    "url": "https://github.com/solidcash/solidcash/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidcash/solidcash.git"
  },
  "license": "MIT",
  "author": "Rosco Kalis <roscokalis@gmail.com>",
  "contributors": [
    "Mathieu Geukens <mr-zwets@protonmail.com>",
    "Gabriel Cardona <gabriel@bitcoin.com>"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./vitest": { "types": "./dist/test/TestExtensions.d.ts", "default": "./dist/test/TestExtensions.js" },
    "./contract-factory": { "types": "./dist/stateful/ContractFactory.d.ts", "default": "./dist/stateful/ContractFactory.js" },
    "./stateful": { "types": "./dist/stateful/index.d.ts", "default": "./dist/stateful/index.js" },
    "./message-bus": { "types": "./dist/message-bus/index.d.ts", "default": "./dist/message-bus/index.js" },
    "./kernel": { "types": "./dist/stateful/kernel/index.d.ts", "default": "./dist/stateful/kernel/index.js" },
    "./framed": { "types": "./dist/framed/index.d.ts", "default": "./dist/framed/index.js" },
    "./oracle": { "types": "./dist/oracle/index.d.ts", "default": "./dist/oracle/index.js" },
    "./bcmr": { "types": "./dist/bcmr/index.d.ts", "default": "./dist/bcmr/index.js" },
    "./network/mock": { "types": "./dist/network/mock/index.d.ts", "default": "./dist/network/mock/index.js" },
    "./network/electrum": { "types": "./dist/network/electrum/index.d.ts", "default": "./dist/network/electrum/index.js" },
    "./hdsigner": { "types": "./dist/HDSigner.d.ts", "default": "./dist/HDSigner.js" },
    "./loop-call": { "types": "./dist/loop-call.d.ts", "default": "./dist/loop-call.js" },
    "./walletconnect": { "types": "./dist/walletconnect-utils.d.ts", "default": "./dist/walletconnect-utils.js" },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "sideEffects": [
    "./dist/test/TestExtensions.js"
  ],
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "build": "yarn compile",
    "clean": "rm -rf ./dist *.tsbuildinfo",
    "compile": "tsc -p tsconfig.build.json",
    "rebuild": "yarn clean && yarn compile",
    "lint": "eslint . --ext .ts --ignore-path ../../.eslintignore",
    "prepare": "yarn rebuild",
    "prepublishOnly": "yarn test && yarn lint",
    "test": "vitest run --exclude 'test/e2e/**'",
    "test:unit": "vitest run test/unit --no-isolate --maxWorkers='60%'",
    "test:conformance": "vitest run test/conformance",
    "test:e2e": "vitest run test/e2e",
    "test:e2e:changed": "vitest run --config vitest.e2e.config.ts --changed --passWithNoTests",
    "test:e2e:watch": "vitest --config vitest.e2e.config.ts",
    "test:fast": "vitest run --no-isolate --maxWorkers='60%' --exclude 'test/e2e/**' --exclude 'test/conformance/**' --exclude 'test/journal-message-bus/**'",
    "test:changed": "vitest run --no-isolate --maxWorkers='60%' --changed --passWithNoTests --exclude 'test/e2e/**' --exclude 'test/conformance/**' --exclude 'test/journal-message-bus/**'",
    "test:watch": "vitest --no-isolate --maxWorkers='60%' --exclude 'test/e2e/**' --exclude 'test/conformance/**' --exclude 'test/journal-message-bus/**'",
    "test:regtest": "node scripts/run-regtest-matrix.mjs"
  },
  "dependencies": {
    "@bitauth/libauth": "git+https://github.com/mainnet-pat/libauth.git#1cf4b432864b3a4ed9f33d1992355d7286f3dab8",
    "@electrum-cash/network": "^4.4.8",
    "@electrum-cash/web-socket": "^4.1.0",
    "@mem-cash/electrum": "^0.0.10",
    "@mem-cash/validation": "^0.0.10",
    "@mr-zwets/bchn-api-wrapper": "^1.0.1",
    "@solidcash/utils": "^0.13.1",
    "fflate": "^0.8.2",
    "semver": "^7.7.2",
    "@noble/hashes": "^2.0.0"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.2",
    "@ethereumjs/evm": "^10.1.2",
    "@ethereumjs/util": "^10.1.2",
    "@psf/bch-js": "^6.8.0",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^8.54.0",
    "ethers": "^6.17.0",
    "p-queue": "^9.1.2",
    "p-retry": "^8.0.0",
    "solc": "^0.8.36",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  },
  "gitHead": "bf02a4b641d5d03c035d052247a545109c17b708",
  "browser": {
    "./dist/framed/proxy/generate.js": "./dist/framed/proxy/generate.browser.js"
  }
}
