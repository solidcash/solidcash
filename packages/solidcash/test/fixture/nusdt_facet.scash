pragma solidcash >=0.8.0;

// Administrative and claim facet. The transfer and supply paths use separate
// branded delegate libraries so each spending input stays below the BCH limit.
//
// Every function here is UPDATE-only on its mappings. A first-touch INSERT cannot
// settle through a delegate (the proxy conserves its own-category mutable NFT
// count and an insert mints a node), so key creation lives on the master.
//
// The other thing that cannot be delegated is a TOKEN CONTAINER: a delegate input
// fails its covenant on any container operation, including a plain read. Everything
// that touches the reserve therefore lives on the master, which is why `deposit` is
// there and the update-only transfer paths are here.
//
// Runs as a delegate against the proxy master's state, so the state block below
// MUST stay byte-identical to nusdt_state.inc and to the master.
library UsdtFacet {


    event Approval(address indexed tokenOwner, address indexed spender, uint256 value);
    event Pause();
    event Unpause();
    event Deprecate(address newAddress);
    event RemovedBlackList(address indexed user);
    event Unfrozen(address indexed user);
    event QuarantineParams(int blocks);

    event DepositClaimed(address indexed to, int value);

    // ---- shared state layout (see nusdt_state.inc) ----
    address owner;
    int totalSupply;
    mapping(address => int) balances;
    mapping(address => mapping(address => uint256)) allowed;
    bool paused;
    mapping(address => bool) isBlackListed;
    bytes32 name;
    bytes32 symbol;
    uint8 decimals;
    bool deprecated;
    address upgradedAddress;
    mapping(address => bool) frozen;
    mapping(address => int) pendingAmount;
    mapping(address => int) pendingUnlockAt;
    int quarantineBlocks;
    bytes32 backingCategory;
    bool backingSet;
    int containerSeen;
    int backedSupply;
    int clock;

    function transferOwnership(address newOwner) public {
        require(msg.sender == this.owner);
        require(newOwner != this.owner);
        this.owner = newOwner;
    }

    function pause() public {
        require(msg.sender == this.owner);
        require(!this.paused);
        this.paused = true;
        emit Pause();
    }

    function unpause() public {
        require(msg.sender == this.owner);
        require(this.paused);
        this.paused = false;
        emit Unpause();
    }

    function removeBlackList(address clearedUser) public {
        require(msg.sender == this.owner);
        this.isBlackListed[clearedUser] = false;
        emit RemovedBlackList(clearedUser);
    }

    function unfreeze(address user) public {
        require(msg.sender == this.owner);
        this.frozen[user] = false;
        emit Unfrozen(user);
    }

    function deprecate(address newAddress) public {
        require(msg.sender == this.owner);
        this.deprecated = true;
        this.upgradedAddress = newAddress;
        emit Deprecate(newAddress);
    }

    function setQuarantineBlocks(int blocks) public {
        require(msg.sender == this.owner);
        require(blocks >= 0);
        this.quarantineBlocks = blocks;
        emit QuarantineParams(blocks);
    }
    function tick(int nowHeight) public {
        require(tx.time >= nowHeight);
        require(nowHeight >= this.clock);
        this.clock = nowHeight;
    }

    // Re-entry, step 3. Permissionless and consensus-gated: the CLTV compare cannot
    // be accelerated, so a matured claim is a fact about the chain, not about who
    // is asking. The issuer's only lever is to blacklist or freeze the claimant
    // inside the window, checked here.
    function claimDeposit() public {
        require(!this.paused);
        require(!this.deprecated);
        address claimant = msg.sender;
        int pending = this.pendingAmount[claimant];
        require(pending > 0);
        require(tx.time >= this.pendingUnlockAt[claimant]);
        require(!this.isBlackListed[claimant]);
        require(!this.frozen[claimant]);

        this.pendingAmount[claimant] = 0;
        this.pendingUnlockAt[claimant] = 0;
        this.balances[claimant] = this.balances[claimant] + pending;
        emit DepositClaimed(claimant, pending);
    }
}
