pragma solidcash >=0.8.0;

// =============================================================================
// NativeTetherToken, composed by INHERITANCE and partitioned by the built-in
// splitter (compileFileSplit) - not by hand-rolled delegate-library facets.
//
// Same contract as native_usdt.scash, reorganised into the deployed USDT's own
// contract hierarchy:
//
//   Ownable
//   Pausable      is Ownable
//   BasicToken    is Ownable          balances, the fee mechanism, transfer
//   StandardToken is BasicToken       allowances, transferFrom, approve
//   BlackList     is BasicToken       isBlackListed, destroyBlackFunds
//   Freezable     is Ownable          (extension) reversible per-account freeze
//   Backed        is Ownable          (extension) the FT reserve and withdraw
//   Quarantined   is Backed           (extension) the admission boundary
//   NativeTetherToken is Pausable, StandardToken, BlackList, Freezable, Quarantined
//
// Ownable is reached along five paths, so this leans on C3 linearization to give
// `owner` and `onlyOwner` exactly one definition in the flattened contract.
//
// Why this shape rather than the six-file facet split (nusdt*.scash):
//   * The state layout is declared ONCE. The facet split duplicates a 20-variable
//     block across six files with only a test to keep them honest, because a
//     delegate writes the caller's state by slot and libraries cannot inherit.
//   * `struct Pending` is usable again. The facet split had to degrade it to two
//     parallel mappings, since every facet importing it collided on the struct.
//   * Forwarders disappear. No named-forwarder boilerplate, and no rule that a
//     forwarder's parameter names must match the facet's.
//   * The partition is the compiler's, so it re-plans when bodies change instead
//     of rotting into a hand-drawn line that no longer fits.
//
// Deviations carried over from the facet split, unchanged and for the same
// reasons (see packages/solidc/docs/native-usdt-port.md s2.2): no SafeMath,
// uint8 decimals, bytes32 name/symbol, no upgradedAddress forwarding, no
// on-chain view functions, premint-then-release supply.
// =============================================================================

abstract contract Ownable {

    public address owner;

    modifier onlyOwner() {
        require(msg.sender == this.owner);
        _;
    }

    function transferOwnership(address newOwner) onlyOwner {
        require(newOwner != this.owner);
        this.owner = newOwner;
    }
}

abstract contract Pausable is Ownable {

    public bool paused;

    event Pause();
    event Unpause();

    modifier whenNotPaused() {
        require(!this.paused);
        _;
    }

    modifier whenPaused() {
        require(this.paused);
        _;
    }

    function pause() onlyOwner whenNotPaused {
        this.paused = true;
        emit Pause();
    }

    function unpause() onlyOwner whenPaused {
        this.paused = false;
        emit Unpause();
    }
}

// USDT's BasicToken: the balance ledger, the fee mechanism, and `transfer`.
// Deprecation lives here too, because it is what gates the ERC20 entry points.
abstract contract BasicToken is Ownable {

    public int totalSupply;
    mapping(address => int) public balances;
    public int basisPointsRate;
    public int maximumFee;
    // Fees accrue here rather than into balances[this.owner]: crediting the owner inside
    // transfer is a SECOND write to the sender's own entry whenever the owner is the sender,
    // and two writes to one entry cannot compose on this platform. collectFees() sweeps it.
    public int feeAccrued;
    public bytes32 name;
    public bytes32 symbol;
    public uint8 decimals;
    public bool deprecated;
    public address upgradedAddress;

    event Transfer(address indexed from, address indexed to, int value);
    event Deprecate(address newAddress);
    event Params(int feeBasisPoints, int maxFee);

    modifier notDeprecated() {
        require(!this.deprecated);
        _;
    }

    // Transparency bounds are USDT's own: the fee rate and cap are hard-limited
    // in the contract so the issuer cannot silently raise them.
    function setParams(int newBasisPoints, int newMaxFee) onlyOwner {
        require(newBasisPoints < 20);
        require(newMaxFee < 50);
        this.basisPointsRate = newBasisPoints;
        this.maximumFee = newMaxFee * (10 ** this.decimals);
        emit Params(this.basisPointsRate, this.maximumFee);
    }

    function deprecate(address newAddress) onlyOwner {
        this.deprecated = true;
        this.upgradedAddress = newAddress;
        emit Deprecate(newAddress);
    }
}

// USDT's StandardToken: allowances on top of the balance ledger.
abstract contract StandardToken is BasicToken {

    // USDT's MAX_UINT infinite-allowance sentinel, preserved at full width so a
    // ported integration passing 2**256-1 still means "infinite".
    int constant MAX_ALLOWANCE = 2 ** 256 - 1;

    mapping(address => mapping(address => int)) public allowed;

    event Approval(address indexed tokenOwner, address indexed spender, int value);

    // The EIP-20 race guard IS present in the deployed source: a non-zero
    // allowance must be zeroed before it can be changed to another non-zero value.
    function approve(address spender, int value) notDeprecated {
        address tokenOwner = msg.sender;
        require(!(value != 0 && this.allowed[tokenOwner][spender] != 0));
        this.allowed[tokenOwner][spender] = value;
        emit Approval(tokenOwner, spender, value);
    }
}

abstract contract BlackList is BasicToken {

    mapping(address => bool) public isBlackListed;

    event AddedBlackList(address indexed user);
    event RemovedBlackList(address indexed user);
    event DestroyedBlackFunds(address indexed blackListedUser, int balance);

    function addBlackList(address evilUser) onlyOwner {
        this.isBlackListed[evilUser] = true;
        emit AddedBlackList(evilUser);
    }

    function removeBlackList(address clearedUser) onlyOwner {
        this.isBlackListed[clearedUser] = false;
        emit RemovedBlackList(clearedUser);
    }
}

// Extension: reversible, non-destructive, and distinct from the blacklist. A
// frozen account can neither send nor receive, and cannot claim a matured deposit.
abstract contract Freezable is Ownable {

    mapping(address => bool) public frozen;

    event Frozen(address indexed user);
    event Unfrozen(address indexed user);

    function freeze(address user) onlyOwner {
        this.frozen[user] = true;
        emit Frozen(user);
    }

    function unfreeze(address user) onlyOwner {
        this.frozen[user] = false;
        emit Unfrozen(user);
    }
}

// Extension: the real CashTokens FT reserve behind the ledger.
abstract contract Backed is Ownable {

    // Pinned once by `setBacking` after genesis: the container address derives
    // from this contract's own category ID, so it cannot be known at construction.
    public bytes32 backingCategory;
    public bool backingSet;
    // Ledger's view of the FT reserve held in the backing token container.
    public int containerSeen;
    // Ledger balances + unclaimed pending deposits. Invariant: containerSeen >= backedSupply.
    public int backedSupply;

    event Withdrawal(address indexed from, int value);

    // `containerSeen` is taken from the container's ACTUAL token amount rather
    // than an owner-supplied number, so the owner cannot overstate the premint
    // and `issue` can never release more than physically exists. One-shot.
    function setBacking(bytes32 category) onlyOwner {
        require(!this.backingSet);
        this.backingSet = true;
        this.backingCategory = category;
        this.containerSeen = this.tokens[category].tokenAmount;
    }
}

// Extension: the quarantined admission boundary.
//
// The clock is a CLTV-verified monotonic counter, not a block oracle.
// `require(tx.time >= nowHeight)` makes consensus prove the real chain height is
// at least `nowHeight`, and `nowHeight >= this.clock` forces it forward, so a
// matured claim can never be accelerated. A stale clock only shortens the window.
abstract contract Quarantined is Backed {

    struct Pending {
        int amount;
        int unlockAt;
    }

    mapping(address => Pending) public pendingDeposits;
    public int quarantineBlocks;
    // Monotonic, CLTV-verified chain height.
    public int clock;

    event DepositQuarantined(address indexed to, int value, int unlockAt);
    event DepositClaimed(address indexed to, int value);
    event DepositCancelled(address indexed to, int value);
    event QuarantineParams(int blocks);

    // Permissionless: anybody may keep the quarantine timer honest.
    function tick(int nowHeight) {
        require(tx.time >= nowHeight);
        require(nowHeight >= this.clock);
        this.clock = nowHeight;
    }

    function setQuarantineBlocks(int blocks) onlyOwner {
        require(blocks >= 0);
        this.quarantineBlocks = blocks;
        emit QuarantineParams(blocks);
    }
}

// =============================================================================
// The token. Everything below needs state from more than one base, which is why
// it lives here rather than in one of them.
// =============================================================================
contract NativeTetherToken(address initialOwner)
    is Pausable, StandardToken, BlackList, Freezable, Quarantined
{

    event Issue(int amount);
    event Redeem(int amount);

    // All supply is preminted into the backing token container at genesis; the
    // ledger starts empty and `issue` releases premint into circulation. This is
    // the only sound supply model on BCH: fungible amounts of a category can
    // never be created after the genesis transaction.
    constructor(bytes32 tokenName, bytes32 tokenSymbol, uint8 tokenDecimals, int quarantine) {
        this.name = tokenName;
        this.symbol = tokenSymbol;
        this.decimals = tokenDecimals;
        this.owner = initialOwner;
        this.paused = false;
        this.deprecated = false;
        this.basisPointsRate = 0;
        this.maximumFee = 0;
        this.totalSupply = 0;
        this.containerSeen = 0;
        this.backedSupply = 0;
        this.quarantineBlocks = quarantine;
        this.clock = 0;
        this.backingSet = false;
    }

    // ==== ERC20 movement ====
    // Fee mechanism reproduced exactly: fee = value * basisPointsRate / 10000,
    // capped at maximumFee, credited to the owner, recipient gets value - fee.
    // Both USDT Transfer events are emitted in the original's order.

    function transfer(address to, int value) whenNotPaused notDeprecated {
        address sender = msg.sender;
        require(!this.isBlackListed[sender]);
        require(!this.frozen[sender]);
        require(!this.frozen[to]);

        int fee = (value * this.basisPointsRate) / 10000;
        if (fee > this.maximumFee) {
            fee = this.maximumFee;
        }
        int sendAmount = value - fee;

        require(to != sender);
        require(this.balances[sender] >= value);
        this.balances[sender] = this.balances[sender] - value;
        this.balances[to] = this.balances[to] + sendAmount;
        this.feeAccrued = this.feeAccrued + fee;
        emit Transfer(sender, this.owner, fee);
        emit Transfer(sender, to, sendAmount);
    }

    function transferFrom(address from, address to, int value) whenNotPaused notDeprecated {
        address spender = msg.sender;
        require(!this.isBlackListed[from]);
        require(!this.frozen[from]);
        require(!this.frozen[to]);

        int currentAllowance = this.allowed[from][spender];

        int fee = (value * this.basisPointsRate) / 10000;
        if (fee > this.maximumFee) {
            fee = this.maximumFee;
        }

        // USDT only decrements finite allowances; MAX_ALLOWANCE is the sentinel.
        if (currentAllowance < MAX_ALLOWANCE) {
            require(currentAllowance >= value);
            this.allowed[from][spender] = currentAllowance - value;
        }

        int sendAmount = value - fee;
        require(to != from);
        require(this.balances[from] >= value);
        this.balances[from] = this.balances[from] - value;
        this.balances[to] = this.balances[to] + sendAmount;
        this.feeAccrued = this.feeAccrued + fee;
        emit Transfer(from, this.owner, fee);
        emit Transfer(from, to, sendAmount);
    }

    // ==== Supply ====

    function issue(int amount) onlyOwner {
        require(amount > 0);
        require(this.containerSeen >= this.backedSupply + amount);
        this.balances[this.owner] = this.balances[this.owner] + amount;
        this.totalSupply = this.totalSupply + amount;
        this.backedSupply = this.backedSupply + amount;
        emit Issue(amount);
    }

    function redeem(int amount) onlyOwner {
        require(amount > 0);
        require(this.totalSupply >= amount);
        require(this.balances[this.owner] >= amount);
        this.totalSupply = this.totalSupply - amount;
        this.balances[this.owner] = this.balances[this.owner] - amount;
        this.backedSupply = this.backedSupply - amount;
        emit Redeem(amount);
    }

    // Destroyed funds leave circulation but the underlying FTs stay in the
    // container as unminted premint, so they become re-issuable - the "returning
    // burn" of the supply model, keeping containerSeen >= backedSupply intact.
    function destroyBlackFunds(address blackListedUser) onlyOwner {
        require(this.isBlackListed[blackListedUser]);
        int dirtyFunds = this.balances[blackListedUser];
        this.balances[blackListedUser] = 0;
        this.totalSupply = this.totalSupply - dirtyFunds;
        this.backedSupply = this.backedSupply - dirtyFunds;
        emit DestroyedBlackFunds(blackListedUser, dirtyFunds);
    }

    // ==== The quarantined boundary ====

    // Unwrap: burn ledger balance and hand out real bearer CashTokens. Policy
    // still applies on the way out, which is what makes an exit-side veto
    // possible at all. totalSupply is unchanged - the tokens still exist, they
    // have merely left the tracked set.
    function withdraw(bytes32 category, bytes20 to, int amount) whenNotPaused notDeprecated {
        require(this.backingSet);
        require(category == this.backingCategory);
        address sender = msg.sender;
        require(!this.isBlackListed[sender]);
        require(!this.frozen[sender]);
        require(amount > 0);
        require(this.balances[sender] >= amount);
        require(this.tokens[category].tokenAmount >= amount);

        this.balances[sender] = this.balances[sender] - amount;
        this.backedSupply = this.backedSupply - amount;
        this.containerSeen = this.containerSeen - amount;
        this.tokens[category].transfer(new LockingBytecodeP2PKH(to), amount);
        emit Withdrawal(sender, amount);
    }

    // Re-entry, step 2. Bearer FTs are sent to the container address first (step
    // 1, which needs no contract call and so cannot be censored); this call then
    // proves the container actually grew, by summing every category output of
    // this transaction against the ledger's high-water mark. That sum is what
    // makes the claimed amount unforgeable.
    function deposit(bytes32 category, int nowHeight, int amount) whenNotPaused notDeprecated {
        require(this.backingSet);
        require(category == this.backingCategory);
        require(amount > 0);
        require(tx.time >= nowHeight);
        require(nowHeight >= this.clock);
        this.clock = nowHeight;

        address claimant = msg.sender;
        Pending current = this.pendingDeposits[claimant];
        require(current.amount == 0);

        int delivered = 0;
        for (int i = 0; i < tx.outputs.length; i = i + 1) {
            if (tx.outputs[i].tokenCategory == category) {
                delivered = delivered + tx.outputs[i].tokenAmount;
            }
        }
        require(delivered >= this.containerSeen + amount);

        this.containerSeen = this.containerSeen + amount;
        this.backedSupply = this.backedSupply + amount;

        int unlockAt = nowHeight + this.quarantineBlocks;
        this.pendingDeposits[claimant] = Pending({ amount: amount, unlockAt: unlockAt });
        emit DepositQuarantined(claimant, amount, unlockAt);
    }

    // Re-entry, step 3. Permissionless and consensus-gated: the CLTV compare
    // cannot be accelerated. The issuer's only lever is to blacklist or freeze
    // the claimant inside the window, which is checked here.
    function claimDeposit() whenNotPaused notDeprecated {
        address claimant = msg.sender;
        Pending p = this.pendingDeposits[claimant];
        require(p.amount > 0);
        require(tx.time >= p.unlockAt);
        require(!this.isBlackListed[claimant]);
        require(!this.frozen[claimant]);

        delete this.pendingDeposits[claimant];
        this.balances[claimant] = this.balances[claimant] + p.amount;
        emit DepositClaimed(claimant, p.amount);
    }

    // A refused deposit is never confiscated: the depositor takes the FTs back
    // out to bearer form. Available to a blacklisted or frozen claimant too -
    // refusing admission must not mean seizing funds, or wrapping is a honeypot.
    function cancelDeposit(bytes32 category, bytes20 to) notDeprecated {
        require(this.backingSet);
        require(category == this.backingCategory);
        address claimant = msg.sender;
        Pending p = this.pendingDeposits[claimant];
        require(p.amount > 0);
        require(this.tokens[category].tokenAmount >= p.amount);

        delete this.pendingDeposits[claimant];
        this.containerSeen = this.containerSeen - p.amount;
        this.backedSupply = this.backedSupply - p.amount;
        this.tokens[category].transfer(new LockingBytecodeP2PKH(to), p.amount);
        emit DepositCancelled(claimant, p.amount);
    }

    // Sweep accrued fees into the owner's balance.
    function collectFees() {
        require(msg.sender == this.owner);
        require(this.feeAccrued > 0);
        int amount = this.feeAccrued;
        this.feeAccrued = 0;
        this.balances[this.owner] = this.balances[this.owner] + amount;
    }

    // Open YOUR OWN account. Keyed on msg.sender, so it carries no address argument. A
    // first-touch INSERT cannot settle through a delegate, and two ABSENT keys in one
    // collection prove through the same predecessor - creating all five keys up front makes
    // every later route an UPDATE against a distinct entry.
    function openSelf() {
        address who = msg.sender;
        require(this.balances[who] == 0);
        require(this.pendingDeposits[who].amount == 0);
        this.balances[who] = 0;
        this.pendingDeposits[who] = Pending({ amount: 0, unlockAt: 0 });
        this.isBlackListed[who] = false;
        this.frozen[who] = false;
    }
}
