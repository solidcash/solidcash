pragma solidcash >=0.8.0;

// Facet library: spender-side movement. `transferFrom` is the single largest
// function in the contract - it touches `balances` three times AND the nested
// `allowed` mapping - so it gets a facet to itself.
library UsdtSpend {

    event Transfer(address indexed from, address indexed to, int value);

    // USDT's MAX_UINT infinite-allowance sentinel, preserved at full width so a
    // ported integration that passes 2**256-1 still means "infinite".
    int constant MAX_ALLOWANCE = 2 ** 256 - 1;

    // ---- shared state layout (see nusdt_state.inc) ----
    address owner;
    int totalSupply;
    mapping(address => int) balances;
    int basisPointsRate;
    int maximumFee;
    mapping(address => mapping(address => int)) allowed;
    bool paused;
    mapping(address => bool) isBlackListed;
    bytes32 name;
    bytes32 symbol;
    uint8 decimals;
    bool deprecated;
    address upgradedAddress;
    mapping(address => bool) frozen;
    mapping(address => int) pendingAmount;
    mapping(address => int) pendingUnlockAt;
    int quarantineBlocks;
    bytes32 backingCategory;
    bool backingSet;
    int containerSeen;
    int backedSupply;
    int clock;

    function transferFrom(address from, address to, int value) public {
        require(!this.paused);
        require(!this.deprecated);
        address spender = msg.sender;
        require(!this.isBlackListed[from]);
        require(!this.frozen[from]);
        require(!this.frozen[to]);
        require(value > 0);

        int currentAllowance = this.allowed[from][spender];

        int fee = (value * this.basisPointsRate) / 10000;
        if (fee > this.maximumFee) {
            fee = this.maximumFee;
        }

        // USDT decrements only FINITE allowances; MAX_UINT is the infinite sentinel.
        if (currentAllowance < MAX_ALLOWANCE) {
            require(currentAllowance >= value);
            this.allowed[from][spender] = currentAllowance - value;
        }

        int sendAmount = value - fee;
        require(this.balances[from] >= value);
        this.balances[from] = this.balances[from] - value;
        this.balances[to] = this.balances[to] + sendAmount;
        if (fee > 0) {
            this.balances[this.owner] = this.balances[this.owner] + fee;
            emit Transfer(from, this.owner, fee);
        }
        emit Transfer(from, to, sendAmount);
    }
}
