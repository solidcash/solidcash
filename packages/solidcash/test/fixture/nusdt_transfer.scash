pragma solidcash >=0.8.0;

// Facet library: the ERC-20 movement functions, the two heaviest in the contract
// (each touches `balances` three times plus the compliance mappings, and every
// sorted-mapping access costs roughly a kilobyte).
//
// Runs as a delegate against the proxy master's state, so the state block below
// MUST stay byte-identical to nusdt_state.inc and to every other facet.
library UsdtTransfer {

    event Transfer(address indexed from, address indexed to, int value);

    int constant MAX_ALLOWANCE = 2 ** 256 - 1;

    // ---- shared state layout (see nusdt_state.inc) ----
    address owner;
    int totalSupply;
    mapping(address => int) balances;
    int basisPointsRate;
    int maximumFee;
    mapping(address => mapping(address => int)) allowed;
    bool paused;
    mapping(address => bool) isBlackListed;
    bytes32 name;
    bytes32 symbol;
    uint8 decimals;
    bool deprecated;
    address upgradedAddress;
    mapping(address => bool) frozen;
    mapping(address => int) pendingAmount;
    mapping(address => int) pendingUnlockAt;
    int quarantineBlocks;
    bytes32 backingCategory;
    bool backingSet;
    int containerSeen;
    int backedSupply;
    int clock;

    // USDT's transfer: fee = value * basisPointsRate / 10000 capped at maximumFee,
    // credited to the owner; the recipient gets value - fee. Both Transfer events
    // fire in the original's order (fee first, then the main leg).
    function transfer(address to, int value) public {
        require(!this.paused);
        require(!this.deprecated);
        address sender = msg.sender;
        require(!this.isBlackListed[sender]);
        require(!this.frozen[sender]);
        require(!this.frozen[to]);
        require(value > 0);

        int fee = (value * this.basisPointsRate) / 10000;
        if (fee > this.maximumFee) {
            fee = this.maximumFee;
        }
        int sendAmount = value - fee;

        require(this.balances[sender] >= value);
        this.balances[sender] = this.balances[sender] - value;
        this.balances[to] = this.balances[to] + sendAmount;
        if (fee > 0) {
            this.balances[this.owner] = this.balances[this.owner] + fee;
            emit Transfer(sender, this.owner, fee);
        }
        emit Transfer(sender, to, sendAmount);
    }
}
