{
  "name": "@solidcash/solidhat",
  "version": "0.14.0-beta.1",
  "description": "Hardhat-style project tooling for SolidCash",
  "keywords": ["solidcash", "bitcoin cash", "hardhat", "smart contracts"],
  "homepage": "https://solidcash.org",
  "bugs": { "url": "https://github.com/solidcash/solidcash/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/solidcash/solidcash.git" },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22" },
  "author": "mainnet-pat",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./init": { "types": "./dist/init.d.ts", "default": "./dist/init.js" },
    "./cli-options": { "types": "./dist/cli-options.d.ts", "default": "./dist/cli-options.js" },
    "./cli": { "types": "./dist/cli.d.ts", "default": "./dist/cli.js" },
    "./hardhat2": { "types": "./dist/hardhat2.d.ts", "default": "./dist/hardhat2.js" },
    "./hardhat3": { "types": "./dist/hardhat3.d.ts", "default": "./dist/hardhat3.js" },
    "./ethers5": { "types": "./dist/ethers5.d.ts", "default": "./dist/ethers5.js" },
    "./ethers6": { "types": "./dist/ethers6.d.ts", "default": "./dist/ethers6.js" },
    "./config": { "types": "./dist/config.d.ts", "default": "./dist/config.js" },
    "./vitest-preset": { "types": "./dist/vitest-preset.d.ts", "default": "./dist/vitest-preset.js" },
    "./cashaddr": { "types": "./dist/cashaddr.d.ts", "default": "./dist/cashaddr.js" },
    "./project-fixture": { "types": "./dist/project-fixture.d.ts", "default": "./dist/project-fixture.js" },
    "./ported-script": { "types": "./dist/ported-script.d.ts", "default": "./dist/ported-script.js" },
    "./mock-contracts": { "types": "./dist/mock-contracts/index.d.ts", "default": "./dist/mock-contracts/index.js" },
    "./offline-network": { "types": "./dist/offline-network.d.ts", "default": "./dist/offline-network.js" },
    "./offline-ipfs": { "types": "./dist/offline-ipfs.d.ts", "default": "./dist/offline-ipfs.js" },
    "./offline-rpc": { "types": "./dist/offline-rpc.d.ts", "default": "./dist/offline-rpc.js" },
    "./offline-setup": { "types": "./dist/offline-setup.d.ts", "default": "./dist/offline-setup.js" },
    "./package.json": "./package.json"
  },
  "bin": { "solidhat": "dist/cli.js" },
  "scripts": {
    "build": "yarn compile",
    "clean": "rm -rf ./dist *.tsbuildinfo",
    "compile": "tsc -p tsconfig.build.json",
    "rebuild": "yarn clean && yarn compile",
    "lint": "eslint . --ext .ts --ignore-path ../../.eslintignore",
    "prepare": "yarn rebuild",
    "prepublishOnly": "yarn test && yarn lint",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "@solidcash/testing": "^0.14.0-beta.1",
    "solidcash": "^0.14.0-beta.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "eslint": "^8.54.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  }
}
