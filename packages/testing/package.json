{
  "name": "@solidcash/testing",
  "version": "0.13.1",
  "description": "SolidCash testing framework - Hardhat-style development environment for Bitcoin Cash contracts",
  "keywords": [
    "bitcoin cash",
    "solidcash",
    "testing",
    "smart contracts",
    "hardhat"
  ],
  "homepage": "https://solidcash.org",
  "bugs": {
    "url": "https://github.com/solidcash/solidcash/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidcash/solidcash.git"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "author": "mainnet-pat",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./chai": { "types": "./dist/chai.d.ts", "default": "./dist/chai.js" },
    "./network-helpers": { "types": "./dist/network-helpers.d.ts", "default": "./dist/network-helpers.js" },
    "./ethers": { "types": "./dist/ethers-utils.d.ts", "default": "./dist/ethers-utils.js" },
    "./ethers-shim": { "types": "./dist/ethers-shim.d.ts", "default": "./dist/ethers-shim.js" },
    "./config": { "types": "./dist/config.d.ts", "default": "./dist/config.js" },
    "./hre": { "types": "./dist/hre.d.ts", "default": "./dist/hre.js" },
    "./tasks": { "types": "./dist/tasks.d.ts", "default": "./dist/tasks.js" },
    "./vitest-preset": { "types": "./dist/vitest-preset.d.ts", "default": "./dist/vitest-preset.js" },
    "./vitest-setup": { "types": "./dist/vitest-setup.d.ts", "default": "./dist/vitest-setup.js" },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "sideEffects": false,
  "bin": {
    "solidcash": "dist/cli.js"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "build": "yarn compile",
    "clean": "rm -rf ./dist *.tsbuildinfo",
    "compile": "tsc -p tsconfig.build.json",
    "rebuild": "yarn clean && yarn compile",
    "lint": "eslint . --ext .ts --ignore-path ../../.eslintignore",
    "prepare": "yarn rebuild",
    "prepublishOnly": "yarn test && yarn lint",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bitauth/libauth": "git+https://github.com/mainnet-pat/libauth.git#1cf4b432864b3a4ed9f33d1992355d7286f3dab8",
    "@solidcash/utils": "^0.13.1",
    "ethers": "^6.17.0",
    "solidc": "^0.13.1",
    "solidcash": "^0.13.1"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
