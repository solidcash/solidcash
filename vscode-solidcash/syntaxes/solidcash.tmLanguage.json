{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SolidCash",
  "scopeName": "source.scash",
  "fileTypes": [
    "scash"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#pragma"
    },
    {
      "include": "#assembly"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#types"
    },
    {
      "include": "#storage"
    },
    {
      "include": "#control"
    },
    {
      "include": "#globals"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#members"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "///",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.scash"
            }
          },
          "end": "$",
          "name": "comment.line.documentation.scash",
          "patterns": [
            {
              "match": "@(?:title|author|notice|dev|param|return|inheritdoc|custom:[A-Za-z_]\\w*)\\b",
              "name": "storage.type.annotation.scash"
            }
          ]
        },
        {
          "begin": "/\\*\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.scash"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.scash"
            }
          },
          "name": "comment.block.documentation.scash",
          "patterns": [
            {
              "match": "@(?:title|author|notice|dev|param|return|inheritdoc|custom:[A-Za-z_]\\w*)\\b",
              "name": "storage.type.annotation.scash"
            }
          ]
        },
        {
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.scash"
            }
          },
          "end": "$",
          "name": "comment.line.double-slash.scash"
        },
        {
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.scash"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.scash"
            }
          },
          "name": "comment.block.scash"
        }
      ]
    },
    "pragma": {
      "begin": "\\b(pragma)\\s+(solidcash|solidity)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.directive.scash"
        },
        "2": {
          "name": "entity.name.tag.pragma.scash"
        }
      },
      "end": ";",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.statement.scash"
        }
      },
      "patterns": [
        {
          "match": "[\\^~]|>=?|<=?|=",
          "name": "keyword.operator.version.scash"
        },
        {
          "match": "\\b\\d+\\.\\d+(?:\\.\\d+)?\\b",
          "name": "constant.numeric.version.scash"
        }
      ]
    },
    "assembly": {
      "begin": "\\b(assembly)\\b(?:\\s+(\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'))?\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.assembly.scash"
        },
        "2": {
          "name": "string.quoted.scash"
        },
        "3": {
          "name": "punctuation.section.block.begin.scash"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.scash"
        }
      },
      "name": "meta.embedded.block.assembly.scash",
      "patterns": [
        {
          "include": "#assembly-body"
        }
      ]
    },
    "assembly-block": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.scash"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.scash"
        }
      },
      "patterns": [
        {
          "include": "#assembly-body"
        }
      ]
    },
    "assembly-body": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#assembly-block"
        },
        {
          "match": "\\bOP_[A-Z0-9_]+\\b",
          "name": "support.function.opcode.scash"
        },
        {
          "match": "\\b(?:create2|create|verbatim_[A-Za-z0-9_]*|pc|datasize|dataoffset|datacopy|linkersymbol|byte)\\b(?=\\s*\\()",
          "name": "invalid.illegal.unsupported-builtin.scash"
        },
        {
          "match": "\\bleave\\b",
          "name": "invalid.illegal.unsupported-builtin.scash"
        },
        {
          "match": "\\b(?:let|function|if|switch|case|default|for|break|continue)\\b",
          "name": "keyword.control.assembly.scash"
        },
        {
          "match": "\\b(?:addmod|add|sub|mulmod|mul|div|sdiv|mod|smod|exp|and|or|xor|not|shl|shr|sar|lt|gt|slt|sgt|eq|iszero|mstore8|mstore|mload|keccak256|return|revert|sstore|sload|tstore|tload|caller|callvalue|origin|chainid|number|timestamp|coinbase|difficulty|prevrandao|gasprice|gaslimit|gas|basefee|blobbasefee|balance|selfbalance|extcodesize|extcodehash|address|codesize|calldataload|calldatasize|calldatacopy|returndatasize|returndatacopy|blockhash|log0|log1|log2|log3|log4|staticcall|delegatecall|call|selfdestruct)\\b(?=\\s*\\()",
          "name": "support.function.builtin.assembly.scash"
        },
        {
          "match": "\\.(?:slot|offset|length)\\b",
          "name": "variable.other.property.assembly.scash"
        },
        {
          "match": ":=|->",
          "name": "keyword.operator.assembly.scash"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\\b(hex|unicode)(?=[\"'])",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.scash"
            }
          },
          "end": "(?<=['\"])",
          "name": "meta.string.prefixed.scash",
          "patterns": [
            {
              "begin": "\"",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.string.begin.scash"
                }
              },
              "end": "\"",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.string.end.scash"
                }
              },
              "name": "string.quoted.double.scash"
            },
            {
              "begin": "'",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.string.begin.scash"
                }
              },
              "end": "'",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.string.end.scash"
                }
              },
              "name": "string.quoted.single.scash"
            }
          ]
        },
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.scash"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.scash"
            }
          },
          "name": "string.quoted.double.scash",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.scash"
            }
          ]
        },
        {
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.scash"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.scash"
            }
          },
          "name": "string.quoted.single.scash",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.scash"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX][0-9A-Fa-f_]*\\b",
          "name": "constant.numeric.hex.scash"
        },
        {
          "match": "(?<![\\w.])(?:\\d[\\d_]*\\.\\d[\\d_]*|\\d[\\d_]*)(?:[eE]-?\\d[\\d_]*)?\\b",
          "name": "constant.numeric.scash"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(contract|interface|library|struct|enum|type|error|event)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": {
              "name": "storage.type.declaration.scash"
            },
            "2": {
              "name": "entity.name.type.scash"
            }
          }
        },
        {
          "match": "\\b(function|modifier)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.scash"
            },
            "2": {
              "name": "entity.name.function.scash"
            }
          }
        },
        {
          "match": "\\b(constructor|fallback|receive)\\b",
          "name": "storage.type.function.scash"
        },
        {
          "match": "\\b(import)\\b",
          "name": "keyword.control.import.scash"
        },
        {
          "match": "\\b(from|as|using|for|is|global)\\b",
          "name": "keyword.other.declaration.scash"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(?:bool|bigint|string|bytes|byte|pubkey|sig|datasig|address)(?:\\s+payable)?\\b",
          "name": "storage.type.primitive.scash"
        },
        {
          "match": "\\b(?:u?int(?:8|16|24|32|40|48|56|64|72|80|88|96|104|112|120|128|136|144|152|160|168|176|184|192|200|208|216|224|232|240|248|256)?|u?fixed(?:8|16|24|32|40|48|56|64|72|80|88|96|104|112|120|128|136|144|152|160|168|176|184|192|200|208|216|224|232|240|248|256)?(?:x\\d+)?|bytes(?:[1-9]|[12]\\d|3[0-2]))\\b",
          "name": "storage.type.primitive.scash"
        },
        {
          "match": "\\b(mapping)\\b",
          "name": "storage.type.mapping.scash"
        }
      ]
    },
    "storage": {
      "match": "\\b(?:public|private|internal|external|pure|view|payable|constant|immutable|transient|memory|storage|calldata|indexed|anonymous|abstract|virtual|override|enumerable|packed|upgrade|selfdestruct|split|merge|unsafe)\\b",
      "name": "storage.modifier.scash"
    },
    "control": {
      "patterns": [
        {
          "match": "\\b(?:if|else|for|while|do|switch|case|default|break|continue|try|catch|return|returns|revert|throw|require|assert|emit|delete|unchecked|new)\\b",
          "name": "keyword.control.scash"
        }
      ]
    },
    "globals": {
      "match": "\\b(?:this|tx|msg|block|abi|console|super)\\b",
      "name": "variable.language.scash"
    },
    "builtins": {
      "patterns": [
        {
          "match": "\\b(?:abs|min|max|within|addmod|mulmod|ripemd160|sha1|sha256|keccak256|hash160|hash256|checkSig|checkMultiSig|checkDataSig|toPaddedBytes|intToString|stringToInt|blockhash|blobhash|gasleft|ecrecoverPubKey|ecrecoverP2pkh|ecrecoverEvm|ecrecover|date|unsafe_int|unsafe_bool|unsafe_bytes(?:[1-9]|[12]\\d|3[0-2])?|unsafe_byte)\\b(?=\\s*\\()",
          "name": "support.function.builtin.scash"
        },
        {
          "match": "\\b(?:encode|encodePacked|encodeWithSelector|encodeWithSignature|encodeCall|decode|decodeAt|concat|call|staticcall|delegatecall|transfer|transferNft|push|pop|slice|reverse)\\b(?=\\s*\\()",
          "name": "support.function.builtin.scash"
        },
        {
          "match": "\\b(?:LockingBytecodeP2PKH|LockingBytecodeP2SH20|LockingBytecodeP2SH32|LockingBytecodeNullData)\\b",
          "name": "support.class.scash"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean.scash"
        },
        {
          "match": "\\b(?:seconds|minutes|hours|days|weeks|satoshis|sats|finney|bits|bitcoin|wei|gwei|ether)\\b",
          "name": "constant.language.unit.scash"
        }
      ]
    },
    "operators": {
      "match": "(?:\\*\\*|<<=?|>>=?|&&|\\|\\||==|!=|<=|>=|=>|\\+\\+|--|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|:=|->|[+\\-*/%&|^~!<>=?:])",
      "name": "keyword.operator.scash"
    },
    "members": {
      "patterns": [
        {
          "match": "(?<=\\.)[A-Za-z_$][\\w$]*",
          "name": "variable.other.property.scash"
        },
        {
          "match": "\\b[A-Za-z_$][\\w$]*\\b(?=\\s*\\()",
          "name": "entity.name.function.call.scash"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}\\[\\]()]",
          "name": "punctuation.section.scash"
        },
        {
          "match": "[,;.]",
          "name": "punctuation.separator.scash"
        }
      ]
    }
  }
}
